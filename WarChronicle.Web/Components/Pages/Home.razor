            "Archers" => "archer",
            "Cavalry" => "cavalry",
            "Infantry" => "infantry",
            _ => null
        };
        return unit is null ? null : $"images/units/{faction}-{unit}.png";
    }

    private static string CombatInitiativeClass(string lane, CombatState combat)
    {
        var active = lane switch
        {
            "Priest" => combat.Step == CombatStep.Priest,
            "Archers" => string.Equals(combat.CurrentUnitType, "Archers", StringComparison.OrdinalIgnoreCase)
                || combat.Step == CombatStep.Archers,
            "Cavalry" => string.Equals(combat.CurrentUnitType, "Cavalry", StringComparison.OrdinalIgnoreCase)
                || combat.Step == CombatStep.Cavalry,
            "Infantry" => string.Equals(combat.CurrentUnitType, "Infantry", StringComparison.OrdinalIgnoreCase)
                || combat.Step == CombatStep.Infantry,
            "Levy" => string.Equals(combat.CurrentUnitType, "Levy", StringComparison.OrdinalIgnoreCase)
                || combat.Step == CombatStep.Levy,
            _ => false
        };
        return active ? "is-active" : string.Empty;
    }

    private static string FinaleStepLabel(FinaleStep step) => step switch
    {
        FinaleStep.ResolveReady => "Host Resolve Check",
        FinaleStep.ResolveChoose => "Choose Resolve Result",
        FinaleStep.DeployHost => "Deploy Your Host",
        FinaleStep.RevealMiddelalderen => "Middelalderen Setup",
        FinaleStep.Combat => "Final Combat",
        FinaleStep.Complete => "Finale Complete",
        _ => "Finale"
    };

    private static int TacticNumber(string id)
    {
        var digits = new string(id.Where(char.IsDigit).ToArray());
        return int.TryParse(digits, out var number) ? number : 0;
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
