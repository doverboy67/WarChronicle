    private static string EnemyFactionKey(CombatState combat)
    {
        var label = $"{combat.EnemyName} {combat.SourceLabel}".ToLowerInvariant();
        if (label.Contains("middelalderen")) return "middelalderen";
        if (label.Contains("nightstone")) return "nightstone";
        if (label.Contains("pale hands") || label.Contains("palehands")) return "palehands";
        if (label.Contains("sun-touched") || label.Contains("sun touched") || label.Contains("suntouched")) return "suntouched";
        if (label.Contains("quietus")) return "quietus";
        return "generic";
    }

