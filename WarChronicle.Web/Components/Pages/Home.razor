    private bool IsDepleted(int index)
    {
        if (index < 0 || index >= Session.PlayArea.Count)
            return false;

        var element = Session.PlayArea[index];
        if (element.Kind != PlayAreaKind.Terrain)
            return false;

        bool hostileBefore = index > 0
            && Session.PlayArea[index - 1].Kind == PlayAreaKind.Clearing
            && Session.PlayArea[index - 1].IsHostile;

        bool hostileAfter = index < Session.PlayArea.Count - 1
            && Session.PlayArea[index + 1].Kind == PlayAreaKind.Clearing
            && Session.PlayArea[index + 1].IsHostile;

        return element.IsDepleted || hostileBefore || hostileAfter;
    }

