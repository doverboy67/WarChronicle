    private void OnSessionChanged()
    {
        // Commit the next phase button before the new Chronicle is rendered.
        // Never collapse the panel used to make the previous selection.
        Session.EnsurePhaseGateChronicle();
        _saveStatus = null;
        _gameLogDirty = true;
        _showFullChronicle = false;
        if (!Session.CombatVisible || Session.Combat is null)
            _minimizedCombat = null;
        if (Session.Finale is not { Step: FinaleStep.Complete })
            _finaleSummaryDismissed = false;
        InvokeAsync(StateHasChanged);
    }

