    private static string PieceTitle(PlayAreaElement element)
    {
        if (element.Kind == PlayAreaKind.Clearing)
        {
            var parts = new List<string> { "Clearing" };
            if (element.HasBarbarianIcon) parts.Add("Barbarian icon");
            if (!string.IsNullOrWhiteSpace(element.Controller)) parts.Add($"Controlled by {element.Controller}");
            if (element.IsHostile) parts.Add("Hostile");
            if (element.IsHostLocation) parts.Add("Host location");
            return string.Join(" · ", parts);
        }

        var terrainParts = new List<string> { element.Terrain.ToString() };
        if (element.IsDepleted) terrainParts.Add("Depleted");
        if (element.BonusFood > 0) terrainParts.Add($"Bonus Food {element.BonusFood}");
        return string.Join(" · ", terrainParts);
    }

