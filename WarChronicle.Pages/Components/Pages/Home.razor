    private sealed record BattlePiece(string? ImagePath, string CssClass, string Title);

    private IEnumerable<BattlePiece> BattlePieces(string side, string type, CombatState combat)
    {
        var count = side == "enemy" ? combat.EnemyUnits[type] : combat.PlayerUnits[type];
        if (count <= 0)
            yield break;

        if (string.Equals(type, "Levy", StringComparison.OrdinalIgnoreCase))
        {
            var factionClass = side == "player" ? "levy-player" : $"levy-{EnemyFactionKey(combat)}";
            for (var i = 0; i < count; i++)
                yield return new(null, $"unit-levy {factionClass}", side == "player" ? "Player Levy" : $"{combat.EnemyName} Levy");
            yield break;
        }

        if (side == "player")
        {
            var specialType = type switch
            {
                "Infantry" => "Mercenaries",
                "Cavalry" => "Hedge Knights",
                _ => null
            };
            var specialSurvivors = specialType is null ? 0 : PlayerSpecialSurvivors(type, specialType, combat);
            var regularCount = Math.Max(0, count - specialSurvivors);
            var regularPath = PlayerUnitTokenPath(type);

            for (var i = 0; i < regularCount; i++)
                yield return new(regularPath, UnitArtClass(type), $"Player {type}");

            if (specialType is not null)
            {
                var specialPath = PlayerUnitTokenPath(specialType);
                for (var i = 0; i < specialSurvivors; i++)
                    yield return new(specialPath, UnitArtClass(specialType), specialType == "Mercenaries" ? "Mercenary Infantry" : "Hedge Knight Cavalry");
            }
            yield break;
        }

        var enemyPath = EnemyUnitTokenPath(combat, type);
        if (enemyPath is not null)
        {
            for (var i = 0; i < count; i++)
                yield return new(enemyPath, UnitArtClass(type), $"{combat.EnemyName} {type}");
        }
        else
        {
            for (var i = 0; i < count; i++)
                yield return new(null, BattleUnitClass(type), $"{combat.EnemyName} {type}");
        }
    }

    private int PlayerSpecialSurvivors(string combatType, string specialType, CombatState combat)
    {
        if (combat.IsTest)
            return 0;

        var initialSpecial = Session.Host
            .FirstOrDefault(u => string.Equals(u.Type, specialType, StringComparison.OrdinalIgnoreCase))?.Count ?? 0;
        if (initialSpecial <= 0)
            return 0;

        var initialTotal = combat.InitialPlayerUnits.TryGetValue(combatType, out var initial) ? initial : 0;
        var currentTotal = combat.PlayerUnits.TryGetValue(combatType, out var current) ? current : 0;
        var losses = Math.Max(0, initialTotal - currentTotal);
        return Math.Max(0, initialSpecial - losses);
    }

