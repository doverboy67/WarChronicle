    private bool _debugMode;
    private string? _debugSelectedCardId;
    private int _debugTapCount;
    private DateTime _debugTapWindowStart = DateTime.MinValue;

    private IEnumerable<CampCardState> DebugSceneEchoCards => Catalog
        .GetCampCards(includeOptional: true)
        .Where(c => c.CardType is "Scene" or "Echo")
        .OrderBy(c => c.CardType == "Scene" ? 0 : 1)
        .ThenBy(c => c.CardNum ?? int.MaxValue)
        .ThenBy(c => c.EchoPool)
        .ThenBy(c => c.EchoNum ?? int.MaxValue)
        .ThenBy(c => c.Title);

    private static string DebugCardLabel(CampCardState card)
    {
        var identity = card.CardType == "Scene"
            ? $"Scene {card.CardNum?.ToString() ?? "?"}"
            : $"Echo {card.EchoPool}-{card.EchoNum?.ToString("00") ?? "??"}";
        return $"{card.Title} — {identity} [{card.Id}]";
    }

    private void SimulateDebugCard()
    {
        if (!string.IsNullOrWhiteSpace(_debugSelectedCardId))
            Session.SimulateCampCard(_debugSelectedCardId);
    }

    // Simulation Lab is deliberately separate from the injected player Session:
    // never subscribe the simulation to player persistence or reassign Session.
    // The catalog uses short internal set keys; the Debug summary should use
    // the player-facing expansion names so Riff Raff (PackC) is not mistaken
    // for a missing content pack. Keep the underlying keys unchanged.
    private static string SimulationContentSetName(string key) => key switch
    {
        "SitA" => "Seasons in the Abyss",
        "SiaSL" => "Stranger in a Strange Land",
        "PackC" => "Riff Raff",
        _ => key
    };

    private bool _showSimulationLab;
    private bool _simulationRunning;
    private bool _simulationStopRequested;
    private string _simulationProgress = string.Empty;
    private SimulationResult? _simulationResult;
    private string? _simulationReportJson;

    private void OpenSimulationLab()
    {
        _showSimulationLab = true;
        _simulationResult = null;
        _simulationReportJson = null;
        _simulationProgress = "";
    }

    private async Task RunSimulationAsync()
    {
        if (_simulationRunning) return;
        _simulationRunning = true;
        _simulationStopRequested = false;
        _simulationResult = null;
        _simulationReportJson = null;
        StateHasChanged();

        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        // The dedicated GameSession uses the same catalog and rules as normal play.
        var simGame = new GameSession(SimulationLoggerFactory.CreateLogger<GameSession>());
        simGame.StartNewGame(Catalog, Session.EnabledContentSets.ToArray());
        simGame.SetMiddelalderenAdvancementCount(Session.MiddelalderenAdvancementCount);
        var pilot = new SimulationPilot(simGame);
        try
        {
            while (!pilot.Complete && !_simulationStopRequested)
            {
                pilot.Step();
                if (pilot.Steps % 64 == 0)
                {
                    _simulationProgress = $"{simGame.CalendarStamp}, Time {simGame.Time}; {pilot.Steps} decisions";
                    StateHasChanged();
                    await Task.Yield(); // UI remains responsive; Stop works in browser.
                }
            }
            stopwatch.Stop();
            var status = _simulationStopRequested ? "Stopped" : pilot.StalledReason is not null ? "Stalled" : "Completed";
            var reason = pilot.StalledReason ?? simGame.CampaignEndReason;
            var host = simGame.Host.GroupBy(x => x.Type)
                .ToDictionary(g => g.Key, g => g.Sum(x => x.Count));
            var resources = simGame.Resources.ToDictionary(x => x.Name, x => x.Value);
            var rapport = simGame.Tribes.ToDictionary(x => x.Name, x => x.Rapport);
            var gameLog = simGame.CreateGameLogJson(AppVersion);
            _simulationResult = new SimulationResult(
                status, simGame.CampaignOutcome, reason, pilot.Steps, stopwatch.ElapsedMilliseconds,
                simGame.Year, simGame.Season, simGame.Time, simGame.Morale, simGame.Leadership,
                host, resources, rapport, simGame.AcquiredAdvancements.Select(x => x.Name).ToArray(),
                simGame.BattleHistory.Count, pilot.Decisions.ToArray(), gameLog);
            // Include the actual game-engine Chronicle and choice trace together.
            // No simulation data is written to player saves or completed-game archive.
            _simulationReportJson = System.Text.Json.JsonSerializer.Serialize(new
            {
                reportType = "War Chronicle Debug Simulation Report",
                reportVersion = 1,
                appVersion = AppVersion,
                result = _simulationResult,
                gameLog = System.Text.Json.JsonDocument.Parse(gameLog).RootElement.Clone()
            }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            _simulationProgress = status;
        }
        catch (Exception ex)
        {
            stopwatch.Stop();
            _simulationProgress = $"Simulation error: {ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _simulationRunning = false;
            StateHasChanged();
        }
    }

    private async Task DownloadSimulationReportAsync()
    {
        if (_simulationReportJson is null) return;
        try
        {
            await JS.InvokeVoidAsync("wcSimExport.start");
            const int chunkSize = 8192;
            var offset = 0;
            while (offset < _simulationReportJson.Length)
            {
                var length = Math.Min(chunkSize, _simulationReportJson.Length - offset);
                // Preserve UTF-16 surrogate pairs while crossing JS interop.
                if (offset + length < _simulationReportJson.Length && length > 0 &&
                    char.IsHighSurrogate(_simulationReportJson[offset + length - 1]) &&
                    char.IsLowSurrogate(_simulationReportJson[offset + length])) length++;
                await JS.InvokeVoidAsync("wcSimExport.append", _simulationReportJson.Substring(offset, length));
                offset += length;
            }
            await JS.InvokeVoidAsync("wcSimExport.finish", $"WC_Simulation_{DateTime.UtcNow:yyyy-MM-dd_HH-mm-ss}.json");
        }
        catch (Exception ex)
        {
            _simulationProgress = $"Export failed: {ex.Message}";
        }
    }

    private void HandleVersionTap()
    {
        var now = DateTime.UtcNow;
        if (_debugTapCount == 0 || now - _debugTapWindowStart > TimeSpan.FromSeconds(3))
        {
            _debugTapCount = 1;
            _debugTapWindowStart = now;
            return;
        }

        _debugTapCount++;
        if (_debugTapCount < 5)
            return;

        _debugMode = !_debugMode;
        _debugTapCount = 0;
        _debugTapWindowStart = DateTime.MinValue;
    }

    private void ExitDebugMode()
    {
        _debugMode = false;
        _debugTapCount = 0;
        _debugTapWindowStart = DateTime.MinValue;
    }

    private const int ChronicleRenderLimit = 120;
    private static readonly TimeSpan ActiveGameLogPersistInterval = TimeSpan.FromSeconds(10);

    private bool _showResumePrompt;
    private bool _showContentSetup;
    private bool _includeSeasons;
    private bool _includeStrangers;
    private bool _includeRiffRaff;
    private bool _includeNoQuarter;
    private int _finaleDifficultyAdvancements = 4;
    private int _lastChronicleCount;
    private bool _hasRenderedChronicle;
    private bool _saveCheckComplete;
    private string? _saveCheckError;
    private string? _saveStatus;
    private string? _resumeError;
    private string? _savedBuildVersion;
    private bool _saveBuildMismatch;
    private bool _saveFormatCompatible = true;
    private bool _preserveExistingSaveForNewGame;
    private bool _showFullChronicle;
    private object? _minimizedCombat;
    private bool _finaleSummaryDismissed;
    private Guid? _archivedGameLogId;
    private string? _gameLogFilename;
    private bool _gameLogDirty;
    private DateTime _lastActiveGameLogPersistUtc = DateTime.MinValue;
    private string SavedBuildLabel => string.IsNullOrWhiteSpace(_savedBuildVersion) ? "an earlier/unknown build" : _savedBuildVersion;
    private int ChronicleRenderStart => _showFullChronicle ? 0 : Math.Max(0, Session.Chronicle.Count - ChronicleRenderLimit);
    private int HiddenChronicleEntryCount => ChronicleRenderStart;
    private string SaveButtonTitle => Session.CanSaveGame ? "Save this campaign in this browser." : Session.SaveUnavailableReason;
    private bool CombatInspectionMode => Session.CombatVisible && Session.Combat is { } combat && IsCombatMinimized(combat);

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await Catalog.InitializeAsync();
    }

    // A saved campaign may exceed Blazor Server's default 32-KB SignalR message limit.
    // Read it in bounded segments instead of a single JS-to-.NET transfer.
    private async Task<string?> LoadSavedGameInChunksAsync()
    {
        const int chunkSize = 8192; // Worst-case UTF-8 stays below the 32-KB message limit.
        const int maxSaveLength = 16 * 1024 * 1024;
        var length = await JS.InvokeAsync<int>("wcSave.getLength");
        if (length < 0)
            return null;
        if (length > maxSaveLength)
            throw new InvalidOperationException("Saved campaign is larger than the supported 16-million-character limit. Please back it up before retrying.");

        var buffer = new System.Text.StringBuilder(length);
        var offset = 0;
        while (offset < length)
        {
            var part = await JS.InvokeAsync<string?>("wcSave.readChunk", offset, chunkSize);
            if (string.IsNullOrEmpty(part) || offset + part.Length > length)
                throw new InvalidOperationException("Saved campaign changed or was interrupted during loading.");
            buffer.Append(part);
            offset += part.Length;
        }
        if (await JS.InvokeAsync<int>("wcSave.getLength") != length)
            throw new InvalidOperationException("Saved campaign changed while loading. Please retry.");
        return buffer.ToString();
    }

    private async Task CheckSavedGameAsync()
    {
        _saveCheckError = null;
        _showResumePrompt = false;
        _showContentSetup = false;
        try
        {
            var exists = await JS.InvokeAsync<bool>("wcSave.hasSave");
            if (!exists)
            {
                _showContentSetup = true;
                _savedBuildVersion = null;
                _saveFormatCompatible = true;
                _saveBuildMismatch = false;
            }
            else
            {
                // Preserve the resume prompt even if the save is incompatible.
                _showResumePrompt = true;
                var json = await LoadSavedGameInChunksAsync();
                if (!string.IsNullOrWhiteSpace(json)
                    && Session.TryReadSaveMetadata(json, out var buildVersion, out _, out var formatCompatible))
                {
                    _savedBuildVersion = buildVersion;
                    _saveFormatCompatible = formatCompatible;
                    _saveBuildMismatch = string.IsNullOrWhiteSpace(buildVersion)
                        || !string.Equals(buildVersion, AppVersion, StringComparison.OrdinalIgnoreCase);
                }
                else
                {
                    _savedBuildVersion = null;
                    _saveFormatCompatible = false;
                    _saveBuildMismatch = true;
                }
            }
        }
        catch (Exception)
        {
            // Never silently replace a possibly saved campaign with New Chronicle.
            _showResumePrompt = false;
            _showContentSetup = false;
            _saveCheckError = "The browser connection or saved-game read failed. Retry after the connection is restored.";
        }
        await InvokeAsync(StateHasChanged);
    }

    private Task RetrySavedGameCheckAsync() => CheckSavedGameAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_saveCheckComplete)
        {
            _saveCheckComplete = true;
            await CheckSavedGameAsync();
        }

        if (Session.GameEndedUtc is not null && _archivedGameLogId != Session.GameLogId)
            await ArchiveCompletedGameLogAsync();
        else if (Session.GameEndedUtc is null && _gameLogDirty && !_showResumePrompt && !_showContentSetup)
            await PersistActiveGameLogAsync();

        // Anchor the old viewport after DOM changes, then ease out toward the
        // FIRST new text. The browser's natural bottom limit is respected.
        var currentChronicleCount = Session.Chronicle.Count;
        var firstNewIndex = _hasRenderedChronicle && currentChronicleCount > _lastChronicleCount
            && _lastChronicleCount >= ChronicleRenderStart && !_showContentSetup && !_showResumePrompt
                ? _lastChronicleCount
                : -1;
        try
        {
            await JS.InvokeVoidAsync("wcChronicle.restoreAndScrollToFirstNew", firstNewIndex);
        }
        catch
        {
            // Scrolling is a presentation enhancement, never a gameplay dependency.
        }
        _lastChronicleCount = currentChronicleCount;
        _hasRenderedChronicle = true;

        try
        {
            await JS.InvokeVoidAsync("wcActionLock.release");
        }
        catch
        {
            // Action locking is a UI safety feature only; never interrupt play if JS is unavailable.
        }
    }

    private async Task SaveGameAsync()
    {
        if (!Session.CanSaveGame)
            return;

        try
        {
            var json = Session.CreateSaveJson(AppVersion);
            await JS.InvokeVoidAsync("wcSave.save", json);
            _saveStatus = "Saved";
            await PersistActiveGameLogAsync(force: true);
        }
        catch
        {
            _saveStatus = "Save failed";
        }
    }

    private async Task ContinueSavedGameAsync()
    {
        _resumeError = null;
        if (!_saveFormatCompatible)
        {
            _resumeError = "That save format is not compatible with this build.";
            return;
        }

        try
        {
            var json = await LoadSavedGameInChunksAsync();
            if (!string.IsNullOrWhiteSpace(json) && Session.TryRestoreSaveJson(json, Catalog))
            {
                _showResumePrompt = false;
                _showContentSetup = false;
                _preserveExistingSaveForNewGame = false;
                _showFullChronicle = false;
                _lastChronicleCount = Session.Chronicle.Count; // Restored history is not newly generated text.
                _lastActiveGameLogPersistUtc = DateTime.MinValue;
                _saveStatus = _saveBuildMismatch ? $"Loaded {SavedBuildLabel} save" : "Save loaded";
                return;
            }

            _resumeError = "That save could not be restored. You can start a new campaign instead.";
        }
        catch
        {
            _resumeError = "That save could not be restored. You can start a new campaign instead.";
        }
    }

    private Task StartFreshGameAsync()
    {
        _preserveExistingSaveForNewGame = true;
        _showResumePrompt = false;
        _showContentSetup = true;
        _includeSeasons = false;
        _includeStrangers = false;
        _includeRiffRaff = false;
        _includeNoQuarter = false;
        _saveStatus = null;
        _resumeError = null;
        return Task.CompletedTask;
    }

    private void ReturnToSavedGamePrompt()
    {
        _showContentSetup = false;
        _showResumePrompt = true;
        _preserveExistingSaveForNewGame = false;
        _resumeError = null;
    }

    private async Task StartNewGameFromDefeatAsync()
    {
        // Make one final archive attempt before leaving the completed campaign.
        if (Session.GameEndedUtc is not null && _archivedGameLogId != Session.GameLogId)
            await ArchiveCompletedGameLogAsync();

        // Clear only resumable campaign state, then return to content selection.
        await JS.InvokeVoidAsync("wcSave.clear");
        await JS.InvokeVoidAsync("wcGameLog.clearActive");
        _showResumePrompt = false;
        _showContentSetup = true;
        _includeSeasons = false;
        _includeStrangers = false;
        _includeRiffRaff = false;
        _includeNoQuarter = false;
        _saveStatus = null;
        _resumeError = null;
        _archivedGameLogId = null;
        _gameLogFilename = null;
        _finaleSummaryDismissed = false;
        _showFullChronicle = false;
        _preserveExistingSaveForNewGame = false;
        _lastActiveGameLogPersistUtc = DateTime.MinValue;
        _savedBuildVersion = null;
        _saveBuildMismatch = false;
        _saveFormatCompatible = true;
    }

    private async Task BeginNewChronicleAsync()
    {
        var sets = new List<string> { "Base" };
        if (_includeSeasons)
            sets.Add("SitA");
        if (_includeStrangers)
            sets.Add("SiaSL");
        if (_includeRiffRaff)
            sets.Add("PackC");
        if (_includeNoQuarter)
            sets.Add("No Quarter");

        Session.StartNewGame(Catalog, sets);
        Session.SetMiddelalderenAdvancementCount(_finaleDifficultyAdvancements);
        await JS.InvokeVoidAsync("wcSave.clear");
        await JS.InvokeVoidAsync("wcGameLog.clearActive");

        _gameLogDirty = true;
        _lastActiveGameLogPersistUtc = DateTime.MinValue;
        _archivedGameLogId = null;
        _gameLogFilename = null;
        _finaleSummaryDismissed = false;
        _showFullChronicle = false;
        _showContentSetup = false;
        _showResumePrompt = false;
        _preserveExistingSaveForNewGame = false;
        _savedBuildVersion = AppVersion;
        _saveBuildMismatch = false;
        _saveFormatCompatible = true;
        _saveStatus = null;
        _resumeError = null;
    }

    private async Task PersistActiveGameLogAsync(bool force = false)
    {
        var now = DateTime.UtcNow;
        if (!force && now - _lastActiveGameLogPersistUtc < ActiveGameLogPersistInterval)
            return;

        _gameLogDirty = false;
        _lastActiveGameLogPersistUtc = now;
        try
        {
            var json = Session.CreateGameLogJson(AppVersion);
            await JS.InvokeVoidAsync("wcGameLog.saveActive", json);
        }
        catch
        {
            // Logging is best-effort and must never interrupt play. Retry after the throttle interval.
            _gameLogDirty = true;
        }
    }

