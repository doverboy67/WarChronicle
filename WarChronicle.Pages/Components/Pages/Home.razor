    private static readonly string[] RiffRaffResultTitles =
    {
        "Jailbreak", "Problem Child", "Ride On", "Dirty Deeds Done Dirt Cheap", "Big Balls",
        "If You Want Blood (You've Got It)", "Night Prowler", "Beating Around the Bush", "Shot Down in Flames", "Highway to Hell",
        "Kicked in the Teeth", "Down Payment Blues", "Dog Eat Dog", "Whole Lotta Rosie", "The Jack",
        "Night of the Long Knives", "This House Is on Fire", "Fly on the Wall", "Thunderstruck", "Moneytalks"
    };

    // Only label completed resource/unit changes, not choices offering possible
    // results, Time advances, die rolls, or narrative paragraphs. A transaction
    // with both a reward and a payment receives a restrained split marker.
    private static string ChronicleTransactionClass(ChronicleEntry entry)
    {
        if (entry.Choices is not null || entry.CampOffers is not null
            || entry.Tone == ChronicleTone.System || string.IsNullOrWhiteSpace(entry.Text))
            return string.Empty;

        var text = entry.Text.Trim();
        var spends = System.Text.RegularExpressions.Regex.IsMatch(text,
            @"^(?:Lose|Loses|Lost|Spend|Spends|Spent|Pay|Pays|Paid|Discard|Discards|Disband|Suffer|Suffers|Remove|Removed|The Host (?:pays|paid|surrenders|offers|loses|spends|disbands)|Winter Attrition removes|\d+ (?:Coin|Food|Wood|Stone|Research) changes hands\b)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase)
            || System.Text.RegularExpressions.Regex.IsMatch(text,
                @"\b(?:for|costs?)\s+\d+\s*(?:Coin|Food|Wood|Stone|Research|Leadership|RT\b|C\b|L\b|R\b)",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var receives = System.Text.RegularExpressions.Regex.IsMatch(text,
            @"^(?:Gain|Gains|Gained|Regain|Regains|Recover|Receive|Receives|Collect|Collects|Recruit|Recruits|Acquire|Acquires|Add|Adds|Restore|Restores|The Host (?:packs|recruits|receives|gains))\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        // A single line can contain several mechanical clauses.
        spends |= System.Text.RegularExpressions.Regex.IsMatch(text,
            @"\b(?:spend|pay|lose)\s+\d+\s+(?:Coin|Food|Wood|Stone|Research|Leadership|Morale|Levy|Infantry|Archers?|Cavalry)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        receives |= System.Text.RegularExpressions.Regex.IsMatch(text,
            @"\b(?:gain|receive|recruit)\s+\d+\s+(?:Coin|Food|Wood|Stone|Research|Leadership|Morale|Levy|Infantry|Archers?|Cavalry)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (spends && receives) return "chronicle-transfer-mixed";
        if (spends) return "chronicle-transfer-spend";
        if (receives) return "chronicle-transfer-receive";
        return string.Empty;
    }

    // Entries are immutable after recording. Cache their formatted HTML so
    // every Blazor render needn't re-run all of the dice/icon regex passes.
    // Per-component cache avoids cross-user state in the hosted server build.
    private readonly Dictionary<string, MarkupString> _chronicleMarkupCache = new(StringComparer.Ordinal);

    private MarkupString ChronicleText(ChronicleEntry entry)
        => ChronicleMarkup(entry.Text);

    private MarkupString ChronicleChoiceText(string text)
        => ChronicleMarkup(text);

    // Compact, designer-facing Advancement costs such as "2L, 1RT" use
    // the same actual token icons as Chronicle transactions. All amounts
    // remain text-readable and selectable with accessible names.
    private static MarkupString ChronicleCostMarkup(string? cost)
        => new(IconifyChronicleMechanicBody(
            System.Text.Encodings.Web.HtmlEncoder.Default.Encode(cost ?? string.Empty)));

    private MarkupString ChronicleMarkup(string? rawText)
    {
        var raw = rawText ?? string.Empty;
        if (_chronicleMarkupCache.TryGetValue(raw, out var cached))
            return cached;
        var riffRaffTitle = RiffRaffResultTitles.FirstOrDefault(title =>
            raw.StartsWith(title + " - ", StringComparison.Ordinal));
        var text = System.Text.Encodings.Web.HtmlEncoder.Default.Encode(raw);
        if (string.IsNullOrWhiteSpace(text))
            return new MarkupString(text);

        // Riff Raff outcome lines retain plain text in saves/logs, while the
        // displayed Chronicle emphasizes the AC/DC song title.
        if (!string.IsNullOrWhiteSpace(riffRaffTitle))
        {
            var encodedTitle = System.Text.Encodings.Web.HtmlEncoder.Default.Encode(riffRaffTitle);
            text = $"<strong>{encodedTitle}</strong>{text[encodedTitle.Length..]}";
        }

        // Chronicle iconography belongs to mechanical statements, not the narrative
        // prose around them. Iconify only action/cost sentences, then let the normal
        // die renderer work on the same encoded string.
        text = IconifyChronicleMechanics(text);

        // HtmlEncoder may encode arithmetic operators. Match both literal and
        // encoded forms so every Chronicle path reaches the same die renderer.
        const string plus = @"(?:\+|&#x2B;|&#43;)";

        // d10 checks stay numeric.
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^Winter Attrition rolls: (?<a>\d+), (?<b>\d+)",
            m => $"Winter Attrition rolls: {NumericDieBadge(m.Groups["a"].Value)}, {NumericDieBadge(m.Groups["b"].Value)}");
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^Winter Attrition roll: (?<a>\d+)",
            m => $"Winter Attrition roll: {NumericDieBadge(m.Groups["a"].Value)}");

        // d3 is not rendered as a d6 face.
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^D3 roll: (?<a>\d+)",
            m => $"D3 roll: {NumericDieBadge(m.Groups["a"].Value)}");
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^Morale roll \(d10\): (?<a>\d+)",
            m => $"Morale roll (d10): {NumericDieBadge(m.Groups["a"].Value)}");

        // Standard 2d6 Leadership test. The first two are primary dice; the
        // third is the Leadership die and receives its own treatment.
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^Roll: (?<a>[1-6]), (?<b>[1-6]), (?<c>[1-6]) \(keep best 2\)",
            m => $"Roll: {D6Badge(m.Groups["a"].Value)} {D6Badge(m.Groups["b"].Value)} {D6Badge(m.Groups["c"].Value, true)} (keep best 2)");

        // Ordinary 2d6 tests and First Contact. These use + in the raw text,
        // which HtmlEncoder can turn into &#x2B; before we get here.
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            $@"^Roll: (?<a>[1-6]) {plus} (?<b>[1-6])",
            m => $"Roll: {D6Badge(m.Groups["a"].Value)} + {D6Badge(m.Groups["b"].Value)}");
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            $@"^First Contact roll: (?<a>[1-6]) {plus} (?<b>[1-6])",
            m => $"First Contact roll: {D6Badge(m.Groups["a"].Value)} + {D6Badge(m.Groups["b"].Value)}");

        // Single d6 breadcrumbs.
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^(?<prefix>Roll|Forage roll|Academy roll): (?<a>[1-6])(?=[\.,]|$)",
            m => $"{m.Groups["prefix"].Value}: {D6Badge(m.Groups["a"].Value)}");

        // Generic collections of d6 results. This catches plain lists as well
        // as labelled per-unit rolls and prevents mixed pip/number displays.
        if (text.StartsWith("Rolls:", StringComparison.OrdinalIgnoreCase)
            || text.StartsWith("Academy rolls:", StringComparison.OrdinalIgnoreCase))
        {
            var period = text.IndexOf('.');
            var head = period >= 0 ? text[..period] : text;
            var tail = period >= 0 ? text[period..] : string.Empty;
            head = System.Text.RegularExpressions.Regex.Replace(
                head,
                @"(?<!\d)(?<d>[1-6])(?!\d)",
                m => D6Badge(m.Groups["d"].Value));
            text = head + tail;
        }

        // Painkiller can report one or several d6s in prose.
        if (text.StartsWith("Painkiller: roll ", StringComparison.OrdinalIgnoreCase))
        {
            var period = text.IndexOf('.');
            var head = period >= 0 ? text[..period] : text;
            var tail = period >= 0 ? text[period..] : string.Empty;
            head = System.Text.RegularExpressions.Regex.Replace(
                head,
                @"(?<!\d)(?<d>[1-6])(?!\d)",
                m => D6Badge(m.Groups["d"].Value));
            text = head + tail;
        }

        // A bare die face is punctuation enough. Do not leave a stray period
        // hanging after lines such as "Roll: [d6]".
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"(</span>)\.$",
            "$1");

        // Once a Chronicle line contains a rendered die, let one shared flex
        // row control the vertical relationship between labels, die faces,
        // operators, DRM text, and totals. This avoids browser text-baseline
        // behavior pulling the die boxes below the surrounding type.
        if (text.Contains("chronicle-die", StringComparison.Ordinal))
            text = $"<span class='chronicle-roll-line'>{text}</span>";

        // Status uses the exact same rapport color rules as the Game State.
        // Only explicit "are now/remain" outcomes are highlighted; ordinary
        // narrative sentences containing a relationship word are untouched.
        text = System.Text.RegularExpressions.Regex.Replace(text,
            @"(?<prefix>\b(?:are now|remain) )(?<level>Hostile|Neutral|Friendly|Allied)(?=\.)",
            m => $"{m.Groups["prefix"].Value}<strong class='rapport chronicle-rapport-level {m.Groups["level"].Value.ToLowerInvariant()}'>{m.Groups["level"].Value}</strong>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        var rendered = new MarkupString(text);
        if (_chronicleMarkupCache.Count >= 2500)
            _chronicleMarkupCache.Clear();
        _chronicleMarkupCache[raw] = rendered;
        return rendered;
    }

    private static string IconifyChronicleMechanics(string text)
    {
        // Mechanical clauses are deliberately scoped to sentence/line starts so prose
        // such as "the villagers speak of Food" remains untouched. If a narrative
        // sentence ends with "Gain 1 Coin...", only that following Gain sentence is
        // iconified.
        const string actionStart = @"(?:^|(?<=[.!?]\s)|(?<=\n))";
        const string actionVerb = @"(?:Gain|Gains|Gained|Lose|Loses|Lost|Pay|Pays|Paid|Spend|Spends|Spent|Receive|Receives|Received|Collect|Collects|Recruit|Recruits|Remove|Removes|Discard|Discards|Return|Returns|Add|Adds|Prevent|Prevents|Recover|Recovers|Restore|Restores|Suffer|Suffers|Acquire|Acquires|Acquired|Purchase|Purchases|Purchased|Buy|Buys|Bought)";

        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            $@"(?<lead>{actionStart}{actionVerb}\b)(?<body>[^.!?\n]*)",
            m => m.Groups["lead"].Value + IconifyChronicleMechanicBody(m.Groups["body"].Value),
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // Actual resource transfers may be written as immersive narration,
        // not only as 'Spend' or 'Gain'. These still need clear iconography.
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            $@"(?<lead>{actionStart}(?:The Host (?:pays|paid|offers|surrenders|recruits|packs|gains|receives)\b|Winter Attrition removes\b))(?<body>[^.!?\n]*)",
            m => m.Groups["lead"].Value + IconifyChronicleMechanicBody(m.Groups["body"].Value),
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // '1 Research changes hands' is a tribute payment, despite lacking
        // an explicit action verb.
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"^(?<qty>\d+)\s+(?<thing>Coin|Food|Wood|Stone|Research)\s+changes hands\b",
            m => ChronicleMechanicAmount(m.Groups["qty"].Value, m.Groups["thing"].Value) + " changes hands",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // Costs and Tributes are often shown as compact designer-facing statements
        // rather than verb sentences, but they are still mechanical information.
        text = System.Text.RegularExpressions.Regex.Replace(
            text,
            $@"(?<lead>{actionStart}(?:Cost|Tribute):)(?<body>[^.!?\n]*)",
            m => m.Groups["lead"].Value + IconifyChronicleMechanicBody(m.Groups["body"].Value),
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return text;
    }

    private static string IconifyChronicleMechanicBody(string body)
    {
        return System.Text.RegularExpressions.Regex.Replace(
            body,
            @"(?<qty>(?:\+|&#x2B;|&#43;)?\d+)(?:\s+(?<thing>Coins?|Leadership|Morale|Food|Wood|Stone|Research(?:\s+Tokens?)?|Shields?|Archers?|Cavalry|Infantry|Levy|Mercenary|Mercenaries|Hedge\s+Knights?)|\s*(?<thing>RT|C|L|R))\b",
            m => ChronicleMechanicAmount(m.Groups["qty"].Value, m.Groups["thing"].Value),
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }

    private static string ChronicleMechanicAmount(string quantity, string thing)
    {
        var number = quantity.StartsWith("&#x2B;", StringComparison.OrdinalIgnoreCase)
            ? quantity[6..]
            : quantity.StartsWith("&#43;", StringComparison.OrdinalIgnoreCase)
                ? quantity[5..]
                : quantity.TrimStart('+');
        var key = thing.Trim().ToLowerInvariant() switch
        {
            "rt" or "r" => "research",
            "c" => "coin",
            "l" => "leadership",
            var other => other
        };

        string? imagePath = key switch
        {
            "coin" or "coins" => "images/tokens/coin.png",
            "food" => "images/tokens/food.png",
            "wood" => "images/tokens/wood.png",
            "stone" => "images/tokens/stone.png",
            "research" or "research token" or "research tokens" => "images/tokens/research.png",
            "shield" or "shields" => "images/tokens/shield.png",
            "archer" or "archers" => "images/units/player-archer.png",
            "cavalry" => "images/units/player-cavalry.png",
            "infantry" => "images/units/player-infantry.png",
            "mercenary" or "mercenaries" => "images/units/player-mercenary.png",
            "hedge knight" or "hedge knights" => "images/units/player-hedge-knight.png",
            _ => null
        };

        var label = key switch
        {
            "coins" => "Coin",
            "research token" or "research tokens" => "Research",
            "shields" => "Shield",
            "archers" => "Archer",
            "mercenaries" => "Mercenary",
            "hedge knights" => "Hedge Knight",
            _ => char.ToUpperInvariant(key[0]) + key[1..]
        };

        // Text remains in the DOM for accessibility, plain-text selection, and
        // copying. Icons use exactly the assets employed elsewhere by the game.
        var amountText = $"<strong class='chronicle-mech-number'>{number}</strong>";
        var wordText = $" <span class='chronicle-mech-word'>{label}</span>";
        if (key == "leadership")
            return $"<span class='chronicle-mech-amount' title='{number} Leadership'>{amountText}<i class='chronicle-mech-icon chronicle-leadership-icon' aria-hidden='true'></i>{wordText}</span>";

        if (key == "levy")
            return $"<span class='chronicle-mech-amount' title='{number} Levy'>{amountText}<i class='chronicle-mech-icon chronicle-levy-icon' aria-hidden='true'></i>{wordText}</span>";

        if (imagePath is null)
            return $"<strong class='chronicle-mech-plain'>{number} {label}</strong>";

        return $"<span class='chronicle-mech-amount' title='{number} {label}'>{amountText}<img class='chronicle-mech-icon' src='{imagePath}' alt='' />{wordText}</span>";
    }

    private static string NumericDieBadge(string value, bool leadership = false)
    {
        var cssClass = leadership ? "chronicle-die leadership-die" : "chronicle-die";
        var titleAttribute = leadership ? " title='Leadership die'" : string.Empty;
        return $"<span class='{cssClass}'{titleAttribute}>{value}</span>";
    }

    private static string D6Badge(string value, bool leadership = false)
    {
        if (!int.TryParse(value, out var die) || die is < 1 or > 6)
            return NumericDieBadge(value, leadership);

        var positions = die switch
        {
            1 => new[] { 5 },
            2 => new[] { 1, 9 },
            3 => new[] { 1, 5, 9 },
            4 => new[] { 1, 3, 7, 9 },
            5 => new[] { 1, 3, 5, 7, 9 },
            6 => new[] { 1, 3, 4, 6, 7, 9 },
            _ => Array.Empty<int>()
        };

        var pips = string.Concat(positions.Select(position => $"<i class='chronicle-pip p{position}'></i>"));
        var cssClass = leadership ? "chronicle-die d6-die leadership-die" : "chronicle-die d6-die";
        var title = leadership ? $"Leadership die: {die}" : $"d6: {die}";
        return $"<span class='{cssClass}' title='{title}' aria-label='{title}'>{pips}</span>";
    }

