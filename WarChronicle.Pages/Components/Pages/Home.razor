@page "/"
@implements IDisposable
@inject GameSession Session
@inject WcDataCatalog Catalog
@inject GameLogFileStore GameLogFiles
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILoggerFactory SimulationLoggerFactory

<PageTitle>War Chronicle</PageTitle>

@if (!string.IsNullOrWhiteSpace(_saveCheckError))
{
    <div class="save-resume-overlay">
        <section class="save-resume-card" role="alertdialog" aria-modal="true" aria-label="Saved game check unavailable">
            <div class="eyebrow">Saved Chronicle</div>
            <h2>Could not check for a saved campaign</h2>
            <p>The browser may still contain your campaign. Nothing was deleted or overwritten.</p>
            <p class="save-error">@_saveCheckError</p>
            <div class="save-resume-actions">
                <button class="primary-save-action" @onclick="RetrySavedGameCheckAsync">Retry saved-game check</button>
            </div>
        </section>
    </div>
}

@if (_showResumePrompt)
{
    <div class="save-resume-overlay">
        <section class="save-resume-card" role="dialog" aria-modal="true" aria-label="Saved War Chronicle campaign">
            <div class="eyebrow">@(_saveBuildMismatch ? "Version Change" : "Saved Chronicle")</div>
            <h2>@(_saveBuildMismatch ? "Saved campaign from an earlier build" : "Continue your campaign?")</h2>
            @if (_saveBuildMismatch)
            {
                <p>This campaign was saved with <strong>@SavedBuildLabel</strong>. The current browser is <strong>@AppVersion</strong>.</p>
                <p>Rules, cards, or game behavior may have changed. Continuing loads the existing campaign into the current build and may produce unexpected results.</p>
            }
            else
            {
                <p>A saved War Chronicle campaign was found in this browser.</p>
            }
            @if (!_saveFormatCompatible)
            {
                <p class="save-error">This save uses an incompatible save format and cannot be continued safely in this build.</p>
            }
            @if (!string.IsNullOrWhiteSpace(_resumeError))
            {
                <p class="save-error">@_resumeError</p>
            }
            <div class="save-resume-actions">
                <button class="primary-save-action" disabled="@(!_saveFormatCompatible)" @onclick="ContinueSavedGameAsync">Continue Saved Game</button>
                <button @onclick="StartFreshGameAsync">Start New Game</button>
            </div>
            <small>Starting a new game does not erase this save until the new Chronicle is actually begun.</small>
        </section>
    </div>
}

@if (_showContentSetup)
{
    <div class="save-resume-overlay">
        <section class="save-resume-card content-setup-card" role="dialog" aria-modal="true" aria-label="Choose War Chronicle content">
            <div class="eyebrow">New Chronicle</div>
            <h2>Choose Content</h2>
            <p>Base content is required. Add any expansion content before the decks are built.</p>
            <div class="content-pack-list">
                <label class="content-pack mandatory">
                    <input type="checkbox" checked disabled />
                    <span><strong>Base Game</strong><small>Required</small></span>
                </label>
                <label class="content-pack">
                    <input type="checkbox" @bind="_includeSeasons" />
                    <span><strong>Seasons in the Abyss</strong><small>Optional Scene, Echo, and Explore content</small></span>
                </label>
                <label class="content-pack">
                    <input type="checkbox" @bind="_includeStrangers" />
                    <span><strong>Stranger in a Strange Land</strong><small>Optional Scene, Echo, and Explore content</small></span>
                </label>
                <label class="content-pack">
                    <input type="checkbox" @bind="_includeRiffRaff" />
                    <span><strong>Riff Raff</strong><small>Optional Riff Raff Scene and Echo arc</small></span>
                </label>
                <label class="content-pack">
                    <input type="checkbox" @bind="_includeNoQuarter" />
                    <span><strong>No Quarter</strong><small>Hard-mode Scene, Echo, and Explore content</small></span>
                </label>
            </div>
            <div class="finale-difficulty-setup">
                <label for="finale-difficulty">Middelalderen Finale difficulty</label>
                <select id="finale-difficulty" @bind="_finaleDifficultyAdvancements">
                    <option value="3">Easy · 3 Advancements</option>
                    <option value="4">Standard · 4 Advancements</option>
                    <option value="5">Hard · 5 Advancements</option>
                    <option value="6">Are You Nuts? · 6 Advancements</option>
                </select>
                <small>Changes only Middelalderen's Advancement draw. Its Host size and all other rules stay the same.</small>
            </div>
            <div class="save-resume-actions">
                <button class="primary-save-action" @onclick="BeginNewChronicleAsync">Begin Chronicle</button>
                @if (_preserveExistingSaveForNewGame)
                {
                    <button @onclick="ReturnToSavedGamePrompt">Back to Saved Game</button>
                }
            </div>
        </section>
    </div>
}

@if (_showSimulationLab)
{
    <div class="save-resume-overlay wc-simulation-overlay">
        <section class="save-resume-card wc-simulation-lab" role="dialog" aria-modal="true" aria-label="Debug Simulation Lab">
            <div class="eyebrow">Debug • Simulation Lab</div>
            <h2>Automated Campaign Test</h2>
            <p>Runs the actual War Chronicle game engine in a separate, temporary session. Your current campaign and browser save are untouched.</p>
            <p><strong>Content:</strong> @string.Join(", ", Session.EnabledContentSets.Select(SimulationContentSetName).OrderBy(x => x))<span> • </span><strong>Finale:</strong> @Session.MiddelalderenAdvancementCount Advancements</p>
            <p><strong>Player:</strong> experimental policy based on prior campaign decisions. It may choose poorly; unsupported decisions stop with a diagnostic rather than skipping rules.</p>
            <div class="save-resume-actions">
                <button class="primary-save-action" disabled="@_simulationRunning" @onclick="RunSimulationAsync">Run One Campaign</button>
                @if (_simulationRunning)
                {
                    <button @onclick="() => _simulationStopRequested = true">Stop after current decision</button>
                }
                <button disabled="@_simulationRunning" @onclick="() => _showSimulationLab = false">Close</button>
            </div>
            @if (_simulationRunning)
            {
                <p class="wc-sim-status">Running: @_simulationProgress</p>
            }
            @if (_simulationResult is { } sim)
            {
                <div class="wc-sim-summary">
                    <h3>@sim.Status @(!string.IsNullOrWhiteSpace(sim.Outcome) ? $"— {sim.Outcome}" : "")</h3>
                    <p>Year @sim.Year, @sim.Season • Time @sim.Time • @sim.Steps decisions • @sim.ElapsedMilliseconds ms</p>
                    <p><strong>Host:</strong> @string.Join(", ", sim.Host.Select(x => $"{x.Key} {x.Value}"))</p>
                    <p><strong>Morale:</strong> @sim.Morale • <strong>Leadership:</strong> @sim.Leadership • <strong>Battles:</strong> @sim.Battles</p>
                    @if (!string.IsNullOrWhiteSpace(sim.Reason))
                    {
                        <p>@sim.Reason</p>
                    }
                    <button class="primary-save-action" @onclick="DownloadSimulationReportAsync">Download Full Simulation Report</button>
                </div>
            }
        </section>
    </div>
}

<div class="game-screen @(CombatInspectionMode ? "combat-inspection-mode" : string.Empty)">
    <section class="state-panel">
        <header class="state-header">
            <div>
                <div class="eyebrow top-build-line">War Chronicle <span aria-hidden="true">•</span> © 2026 - Bill Hunter <span aria-hidden="true">•</span> <span class="app-version" @onclick="HandleVersionTap">@AppVersion</span></div>
                <h1>The Host</h1>
            </div>
            <div class="dev-test-tools">
                <button class="save-game" disabled="@(!Session.CanSaveGame)" title="@SaveButtonTitle" @onclick="SaveGameAsync">Save Game</button>
                <a class="header-action-link" href="War_Chronicle_Rulebook.pdf" target="_blank" rel="noopener" title="Open the War Chronicle rulebook in a new browser tab">Rulebook</a>
                <a class="header-action-link soundtrack-link" href="https://www.youtube.com/playlist?list=PLaMc6s463sdE" target="_blank" rel="noopener noreferrer" title="Open the War Chronicle song references playlist in a new tab">♫ Soundtrack</a>
                <button class="header-action-link" title="Download a diagnostic snapshot of the current campaign" @onclick="DownloadDiagnosticLogAsync">Download Log</button>
                @if (Session.Finale is { Step: FinaleStep.Complete } && _finaleSummaryDismissed)
                {
                    <button class="combat-demo" @onclick="OpenFinaleSummary">Finale Summary</button>
                }
                @if (!string.IsNullOrWhiteSpace(_saveStatus))
                {
                    <span class="save-status">@_saveStatus</span>
                }
                @if (_debugMode)
                {
                    <div class="debug-tools" aria-label="Debug tools">
                        <span class="debug-tools-label">Debug</span>
                        <button class="combat-demo" disabled="@(Session.IsCombatActive || Session.IsFinaleActive)" @onclick="Session.ForceTestCombat">Test Combat</button>
                        <button class="combat-demo" disabled="@(Session.IsCombatActive || Session.IsFinaleActive)" @onclick="Session.ForceTestFinale">Test Finale</button>
                        <button class="combat-demo" disabled="@(Session.IsCombatActive || Session.IsFinaleActive)" @onclick="() => _showCustomFinaleSetup = true">Custom Finale</button>
                        <div class="debug-card-simulator">
                            <select class="debug-card-select" @bind="_debugSelectedCardId" aria-label="Scene or Echo to simulate">
                                <option value="">Simulate Scene / Echo…</option>
                                @foreach (var card in DebugSceneEchoCards)
                                {
                                    <option value="@card.Id">@DebugCardLabel(card)</option>
                                }
                            </select>
                            <button class="combat-demo" disabled="@(!Session.CanSimulateCampCard || string.IsNullOrWhiteSpace(_debugSelectedCardId))" @onclick="SimulateDebugCard">Simulate</button>
                        </div>
                        <button class="combat-demo" @onclick="OpenSimulationLab">Simulation Lab</button>
                        <button class="combat-demo" @onclick="ExitDebugMode">Exit Debug</button>
                    </div>
                }
            </div>
        </header>

        <section class="calendar-strip" aria-label="Calendar">
            <div class="calendar-strip-header">
                <span>Calendar</span>
                <strong>@Session.Season.ToUpperInvariant() • YEAR @Session.Year</strong>
            </div>
            <div class="calendar-spaces">
                @for (var i = 1; i <= 33; i++)
                {
                    var seasonClass = i <= 11 ? "spring" : i <= 22 ? "summer" : "autumn";
                    var fillClass = i <= Session.Time ? "elapsed" : "future";
                    <span class="calendar-space @seasonClass @fillClass" title="Time @i"></span>
                }
            </div>
            <div class="calendar-season-labels">
                <span>Spring</span>
                <span>Summer</span>
                <span>Autumn</span>
            </div>
        </section>

        <div class="state-grid">
            <article class="state-card resources-card">
                <div class="resource-title-grid">
                    <h2>Resources</h2>
                    <span>Have</span>
                    <span class="market-column-head">Market<small>Buy / Sell</small></span>
                </div>
                <div class="resource-table">
                    @foreach (var resource in Session.Resources)
                    {
                        var market = Session.Market.FirstOrDefault(m => m.Resource == resource.Name);
                        var tokenPath = ResourceTokenPath(resource.Name);
                        <div class="resource-table-row">
                            <span class="resource-name">@resource.Name</span>
                            @if (tokenPath is not null)
                            {
                                <span class="resource-have resource-count-display" title="@($"{resource.Name}: {resource.Value}")" aria-label="@($"{resource.Name}: {resource.Value}")">
                                    <span class="resource-count-icon-slot" aria-hidden="true">
                                        <img class="state-token resource-count-icon" src="@tokenPath" alt="" />
                                    </span>
                                    <span class="resource-count-multiplier">× @resource.Value</span>
                                </span>
                            }
                            else
                            {
                                <span class="resource-have resource-count-display">
                                    <span class="resource-count-icon-slot"></span>
                                    <span class="resource-count-multiplier">× @resource.Value</span>
                                </span>
                            }
                            <span class="market-value">
                                @(market is not null ? $"{market.BuyPrice}/{market.SellPrice}" : string.Empty)
                            </span>
                        </div>
                    }
                    <div class="resource-table-row">
                        <span class="resource-name">Leadership</span>
                        <span class="resource-have resource-count-display leadership-have" title="@($"Leadership: {Session.Leadership}")" aria-label="@($"Leadership: {Session.Leadership}")">
                            <span class="resource-count-icon-slot" aria-hidden="true">
                                <i class="leadership-gem"></i>
                            </span>
                            <span class="resource-count-multiplier">× @Session.Leadership</span>
                        </span>
                        <span class="market-value"></span>
                    </div>
                </div>
            </article>

            <article class="state-card host-card">
                <div class="host-title-row">
                    <h2>Host</h2>
                    <div class="host-tracks">
                        <span>Morale <strong>@Session.Morale</strong></span>
                                            </div>
                </div>
                @foreach (var unit in Session.Host)
                {
                    var hostTokenPath = PlayerUnitTokenPath(unit.Type);
                    <div class="host-row">
                        <span class="host-unit-label">
                            @if (hostTokenPath is not null)
                            {
                                <img class="host-unit-token @UnitArtClass(unit.Type)" src="@hostTokenPath" alt="" />
                            }
                            else if (string.Equals(unit.Type, "Levy", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="host-unit-cube player" aria-hidden="true"></i>
                            }
                            <span>@unit.Type</span>
                        </span>
                        <strong>@unit.Count</strong>
                    </div>
                }
                @if (Session.HasPriest)
                {
                    <div class="host-row" title="@PriestHostTooltip()">
                        <span>Priest</span>
                        <strong>1</strong>
                    </div>
                }
            </article>

            <article class="state-card progression-card">
                <div class="progression-title-row">
                    <h2>Advancements</h2>
                </div>

                <div class="progression-section advancement-offer-section">
                    <h3>On Offer</h3>
                    <div class="advancement-offer-list">
                        @foreach (var offer in Session.AdvancementOffer)
                        {
                            var commitLabel = Catalog.GetAdvancementCommitLabel(offer.Id);
                            <article class="advancement-mini-card" title="@offer.Effect">
                                <div class="advancement-mini-card-heading">
                                    <strong>@offer.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(offer.Cost))
                                    {
                                        <span class="advancement-cost-tokens">@ChronicleCostMarkup(offer.Cost)</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(commitLabel))
                                {
                                    <div class="advancement-commit-cost">Commit: @commitLabel</div>
                                }
                                <p>@offer.Effect</p>
                            </article>
                        }
                    </div>
                </div>

                @if (Session.AcquiredAdvancements.Count > 0)
                {
                    <div class="progression-section">
                        <h3>Acquired</h3>
                        <div class="chip-list">
                            @foreach (var advancement in Session.AcquiredAdvancements)
                            {
                                <span class="state-chip" title="@advancement.Effect">@advancement.Name</span>
                            }
                        </div>
                    </div>
                }

                <div class="progression-section">
                    <h3>Available Forces</h3>
                    <div class="available-force-grid">
                        @foreach (var force in Session.AvailableForces)
                        {
                            var forceTokenPath = PlayerUnitTokenPath(force.Type);
                            <span class="available-force-label">
                                @if (forceTokenPath is not null)
                                {
                                    <img class="available-force-token @UnitArtClass(force.Type)" src="@forceTokenPath" alt="" />
                                }
                                else if (string.Equals(force.Type, "Levy", StringComparison.OrdinalIgnoreCase))
                                {
                                    <i class="available-force-cube player" aria-hidden="true"></i>
                                }
                                <span>@force.Type</span>
                            </span><strong>@force.Available</strong>
                        }
                    </div>
                </div>

                <div class="progression-section persistent-section">
                    <h3>Buildings &amp; Roles</h3>
                    @if (Session.PersistentItems.Count == 0)
                    {
                        <span class="empty-state">None</span>
                    }
                    else
                    {
                        <div class="chip-list">
                            @foreach (var item in Session.PersistentItems)
                            {
                                <span class="state-chip" title="@PersistentTooltip(item.Name)">@item.Name@(string.IsNullOrWhiteSpace(item.Detail) ? "" : $": {item.Detail}")</span>
                            }
                        </div>
                    }
                </div>

                @if (Session.VisibleReminders.Count > 0)
                {
                    <div class="progression-section">
                        <h3>Reminders</h3>
                        <div class="chip-list">
                            @foreach (var reminder in Session.VisibleReminders)
                            {
                                var reminderTokenPath = PersistentTokenPath(reminder);
                                <span class="state-chip reminder-state-chip @(reminderTokenPath is not null ? "has-token-art" : string.Empty)" title="@PersistentTooltip(reminder)">
                                    @if (reminderTokenPath is not null)
                                    {
                                        <img class="reminder-token-art" src="@reminderTokenPath" alt="" />
                                    }
                                    <span>@reminder</span>
                                </span>
                            }
                        </div>
                    </div>
                }
            </article>

            <article class="state-card baggage-card">
                <h2>Baggage Train</h2>
                <div class="baggage-grid">
                    @foreach (var slot in Session.Baggage)
                    {
                        var baggageTokenPath = BaggageTokenPath(slot);
                        <div class="baggage-slot @(slot.Damaged ? "damaged" : null)" title="@BaggageLabel(slot)">
                            <small>@slot.Position</small>
                            @if (slot.Damaged)
                            {
                                <span class="baggage-empty">Damaged</span>
                            }
                            else if (baggageTokenPath is not null)
                            {
                                <span class="baggage-token-stack" aria-label="@BaggageLabel(slot)">
                                    @for (var tokenIndex = 0; tokenIndex < Math.Max(1, slot.Quantity); tokenIndex++)
                                    {
                                        <img class="baggage-token" src="@baggageTokenPath" alt="" />
                                    }
                                </span>
                            }
                            else if (!string.IsNullOrWhiteSpace(slot.Contents))
                            {
                                <span class="baggage-special">@slot.Contents</span>
                            }
                            else
                            {
                                <span class="baggage-empty">Empty</span>
                            }
                        </div>
                    }
                </div>
            </article>

            <article class="state-card rapport-card">
                <h2>Rapport</h2>
                @foreach (var tribe in Session.Tribes.OrderBy(RapportTribeOrder))
                {
                    <div class="rapport-row" title="@RapportTooltip(tribe)">
                        <span>@DisplayRapportTribeName(tribe.Name)</span>
                        <strong class="rapport @(tribe.Rapport.ToLowerInvariant())">
                            @tribe.Rapport
                            @if (!string.Equals(tribe.Rapport, "Unmet", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="rapport-drm">• @RapportDrmLabel(tribe.Rapport)</span>
                            }
                        </strong>
                    </div>
                }
            </article>
        </div>

        <article class="play-area-card">
            <div class="play-area-heading">
                <div>
                    <span class="eyebrow">Explored Country</span>
                    <h2>Play Area</h2>
                </div>
                <div class="legend">
                    <span><i class="legend-shape clearing"></i> Clearing</span>
                    <span><i class="legend-shape plains"></i> Plains</span>
                    <span><i class="legend-shape forest"></i> Forest</span>
                    <span><i class="legend-shape mountain"></i> Mountain</span>
                </div>
            </div>

            <div class="play-area-visual" aria-label="Current explored play area">
                @for (var i = 0; i < Session.PlayArea.Count; i++)
                {
                    var index = i;
                    var element = Session.PlayArea[index];
                    <div class="map-piece @PieceClass(element)" style="@PieceStyle(element.Sequence)" title="@PieceTitle(element)">
                        @if (element.Kind == PlayAreaKind.Clearing && element.HasBarbarianIcon && string.IsNullOrWhiteSpace(element.Controller))
                        {
                            <span class="barbarian-site-mark" aria-label="Barbarian clearing">✦</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(element.Controller))
                        {
                            <span class="control-mark @ControlClass(element)" aria-label="@ControlAria(element)">
                                @ControlLabel(element)
                            </span>
                        }
                        @if (element.BonusFood > 0)
                        {
                            <span class="terrain-resource-bonus" title="Bonus Food: @element.BonusFood" aria-label="Bonus Food: @element.BonusFood">
                                <img src="images/tokens/food.png" alt="" />
                                @if (element.BonusFood > 1)
                                {
                                    <span class="terrain-resource-bonus-count">×@element.BonusFood</span>
                                }
                            </span>
                        }
                        @if (IsDepleted(index))
                        {
                            <img class="depleted-token" src="images/tokens/depleted.png" title="Depleted or suppressed terrain" aria-label="Depleted or suppressed terrain" alt="" />
                        }
                        @if (element.IsHostLocation)
                        {
                            <span class="host-marker">HOST</span>
                        }
                    </div>
                }

                <div class="control-legend" aria-label="Control marker legend">
                    <span><i class="mini-control player"></i> You</span>
                    <span><i class="mini-control suntouched">ST</i></span>
                    <span><i class="mini-control nightstone">NS</i></span>
                    <span><i class="mini-control palehands">PH</i></span>
                    <span><i class="mini-control quietus">TQ</i></span>
                    <span><i class="hostile-key">!</i> Hostile</span>
                </div>
            </div>
        </article>
    </section>

    <section class="chronicle-panel">
        <header class="chronicle-header">
            <div>
                <div class="eyebrow">Chronicle</div>
                <h2>The Chronicle</h2>
            </div>
        </header>

        <div class="chronicle-scroll">
            @if (HiddenChronicleEntryCount > 0)
            {
                <div class="chronicle-history-control">
                    <span>@HiddenChronicleEntryCount earlier Chronicle entries are retained but not rendered for performance.</span>
                    <button class="secondary-action" @onclick="ShowFullChronicle">Show Earlier History</button>
                </div>
            }
            else if (_showFullChronicle && Session.Chronicle.Count > ChronicleRenderLimit)
            {
                <div class="chronicle-history-control">
                    <span>Full Chronicle history is currently rendered.</span>
                    <button class="secondary-action" @onclick="ShowRecentChronicle">Show Recent Only</button>
                </div>
            }

            @for (var chronicleIndex = ChronicleRenderStart; chronicleIndex < Session.Chronicle.Count; chronicleIndex++)
            {
                var entry = Session.Chronicle[chronicleIndex];
                var entryIndex = chronicleIndex; // Capture a stable index for each click handler.
                var decisionActive = Session.IsChronicleDecisionActive(chronicleIndex) || Session.IsChroniclePhaseGateActive(chronicleIndex);
                var campOfferActive = Session.IsChronicleCampOfferActive(chronicleIndex);
                var chronicleTypeClass = entry.Calendar.Contains("• Scene", StringComparison.OrdinalIgnoreCase)
                    ? "scene-event"
                    : entry.Calendar.Contains("• Echo", StringComparison.OrdinalIgnoreCase)
                        ? "echo-event"
                        : entry.Calendar.Contains("• Chronicle", StringComparison.OrdinalIgnoreCase)
                            ? "browser-flavor"
                            : !string.IsNullOrWhiteSpace(entry.Heading) && entry.Calendar.Contains("• Explore", StringComparison.OrdinalIgnoreCase)
                                ? "explore-event"
                                : !string.IsNullOrWhiteSpace(entry.Heading) && entry.Calendar.Contains("• Arrival", StringComparison.OrdinalIgnoreCase)
                                    ? "arrival-event"
                                    : !string.IsNullOrWhiteSpace(entry.Heading) && entry.Calendar.Contains("• Camp", StringComparison.OrdinalIgnoreCase)
                                        ? "camp-event"
                                        : string.Empty;
                var isPhaseGate = entry.Choices?.Any(c => c.Id.StartsWith("phase-gate:", StringComparison.OrdinalIgnoreCase)) == true;
                var transactionClass = ChronicleTransactionClass(entry);
                var chronicleIconPath = ChronicleIconPath(entry);
                <article @key="chronicleIndex" data-chronicle-index="@chronicleIndex" class="chronicle-entry @(entry.Tone.ToString().ToLowerInvariant()) @(entry.Choices is not null || entry.CampOffers is not null ? "chronicle-decision" : string.Empty) @(string.IsNullOrWhiteSpace(entry.Heading) ? "follow-on" : string.Empty) @chronicleTypeClass @transactionClass @(isPhaseGate ? "phase-gate-event" : string.Empty)">
                    <div class="chronicle-stamp">
                        <span>@ChronicleCalendarStamp(entry.Calendar)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(entry.Heading))
                    {
                        <div class="chronicle-title">
                            @if (chronicleIconPath is not null)
                            {
                                <img class="chronicle-title-icon" src="@chronicleIconPath" alt="" />
                            }
                            <span>@entry.Heading</span>
                            @{
                                var arrivalTribeMeta = ArrivalTribeMeta(entry);
                            }
                            @if (!string.IsNullOrWhiteSpace(arrivalTribeMeta))
                            {
                                <span class="chronicle-title-meta">• @arrivalTribeMeta</span>
                            }
                            @if (chronicleIconPath is not null)
                            {
                                <img class="chronicle-title-icon chronicle-title-icon-trailing" src="@chronicleIconPath" alt="" />
                            }
                        </div>
                    }
                    @if (ChronicleEchoOrigin(entry.Calendar) is { } echoOrigin)
                    {
                        <p class="chronicle-echo-origin">Seeded by: <strong>@echoOrigin</strong></p>
                    }
                    @if (IsWinterDisbandReminder(entry))
                    {
                        <p class="chronicle-winter-reminder"><em>@WinterDisbandReminder(entry)</em></p>
                    }
                    @if (entry.EchoIndicator)
                    {
                        <p class="chronicle-echo-seeded"><img src="images/card-ui/wc_icon_echo.png" alt="Echo consequence" title="This event creates a future Echo." /> <span>@ChronicleText(entry)</span></p>
                    }
                    else
                    {
                        <p>@ChronicleText(entry)</p>
                    }
                    @if (entry.Choices is not null)
                    {
                        <div class="chronicle-choice-options">
                            @foreach (var choice in entry.Choices)
                            {
                                var selected = string.Equals(entry.SelectedChoiceId, choice.Id, StringComparison.OrdinalIgnoreCase);
                                <button aria-pressed="@(selected ? "true" : "false")" class="chronicle-choice @(selected ? "is-selected" : string.Empty) @(choice.Disabled ? "is-unavailable" : string.Empty)"
                                        disabled="@(!decisionActive || choice.Disabled)"
                                        @onclick="() => Session.ResolveChronicleChoice(entryIndex, choice.Id)">
                                    <div class="chronicle-choice-label">
                                        <strong>@ChronicleChoiceText(choice.Label)</strong>
                                        @if (choice.EchoIndicator)
                                        {
                                            <img class="chronicle-choice-echo-icon" src="images/card-ui/wc_icon_echo.png" alt="Echo consequence" title="This choice creates a future Echo." />
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(choice.Detail))
                                    {
                                        <span>@ChronicleChoiceText(choice.Detail)</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    @if (entry.CampOffers is not null)
                    {
                        <div class="camp-choice-list chronicle-camp-offers">
                            @foreach (var card in entry.CampOffers)
                            {
                                var selected = string.Equals(entry.SelectedChoiceId, card.Id, StringComparison.OrdinalIgnoreCase);
                                var locationIcon = CampLocationIconPath(card.Location);
                                <article class="camp-choice-card @(card.Disabled ? "is-unavailable" : string.Empty) @(selected ? "is-selected" : string.Empty)">
                                    <div class="camp-choice-heading">
                                        <strong>@card.Title</strong>
                                        <span class="camp-card-meta">
                                            @if (locationIcon is not null)
                                            {
                                                <span class="camp-meta-item" title="@($"{card.Location} location")"><img src="@locationIcon" alt="" />@card.Location</span>
                                            }
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(card.Flavor))
                                    {
                                        <p class="camp-choice-flavor">@card.Flavor</p>
                                    }
                                    <div class="camp-choice-effect">@((MarkupString)card.Effect)</div>
                                    @if (card.ShowCampStewardNote)
                                    {
                                        <div class="camp-card-rules-note">
                                            <strong>Camp Steward active</strong>
                                            <span>After resolving normal Work, you may also spend 1 Coin for 1 adjacent Terrain Resource, or buy 1 Resource at Market Buy value -1 Coin (minimum 1 Coin).</span>
                                        </div>
                                    }
                                    @if (card.ShowFieldStaffNote)
                                    {
                                        <div class="camp-card-rules-note">
                                            <strong>Role effects</strong>
                                            <span><b>Scouting:</b> When Exploring, draw 2 Terrain cards and choose 1.</span>
                                            <span><b>Camp Steward:</b> After normal Work, you may also spend 1 Coin for 1 adjacent Terrain Resource, or buy 1 Resource at Market Buy value -1 Coin (minimum 1 Coin).</span>
                                        </div>
                                    }
                                    @if (card.Disabled && !string.IsNullOrWhiteSpace(card.UnavailableReason))
                                    {
                                        <div class="camp-choice-unavailable">@card.UnavailableReason</div>
                                    }
                                    <button class="camp-choice-select @(selected ? "is-selected" : string.Empty)"
                                            disabled="@(!campOfferActive || card.Disabled)"
                                            aria-pressed="@(selected ? "true" : "false")"
                                            @onclick="() => Session.ChooseCampCard(card.Id)">
                                        Choose @card.Title
                                    </button>
                                </article>
                            }
                        </div>
                    }
                </article>
            }

            @if (_debugMode && Session.DebugSimulationChronicle.Count > 0)
            {
                <div class="chronicle-history-control">
                    <span>Debug simulation complete. Campaign state restored; this result is not part of the saved Chronicle.</span>
                </div>
                @foreach (var entry in Session.DebugSimulationChronicle)
                {
                    var debugTypeClass = entry.Calendar.Contains("• Scene", StringComparison.OrdinalIgnoreCase)
                        ? "scene-event"
                        : entry.Calendar.Contains("• Echo", StringComparison.OrdinalIgnoreCase)
                            ? "echo-event"
                            : string.Empty;
                    <article class="chronicle-entry @(entry.Tone.ToString().ToLowerInvariant()) @(entry.Choices is not null ? "chronicle-decision" : string.Empty) @(string.IsNullOrWhiteSpace(entry.Heading) ? "follow-on" : string.Empty) @debugTypeClass">
                        <div class="chronicle-stamp">
                            <span>DEBUG • @ChronicleCalendarStamp(entry.Calendar)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.Heading))
                        {
                            <div class="chronicle-title"><span>@entry.Heading</span></div>
                        }
                        @if (ChronicleEchoOrigin(entry.Calendar) is { } debugEchoOrigin)
                        {
                            <p class="chronicle-echo-origin">Seeded by: <strong>@debugEchoOrigin</strong></p>
                        }
                        @if (IsWinterDisbandReminder(entry))
                        {
                            <p class="chronicle-winter-reminder"><em>@WinterDisbandReminder(entry)</em></p>
                        }
                        @if (entry.EchoIndicator)
                        {
                            <p class="chronicle-echo-seeded"><img src="images/card-ui/wc_icon_echo.png" alt="Echo consequence" /> <span>@ChronicleText(entry)</span></p>
                        }
                        else
                        {
                            <p>@ChronicleText(entry)</p>
                        }
                        @if (entry.Choices is not null)
                        {
                            <div class="chronicle-choice-options">
                                @foreach (var choice in entry.Choices)
                                {
                                    var selected = string.Equals(entry.SelectedChoiceId, choice.Id, StringComparison.OrdinalIgnoreCase);
                                    <button class="chronicle-choice @(selected ? "is-selected" : string.Empty) @(choice.Disabled ? "is-unavailable" : string.Empty)" disabled>
                                        <div class="chronicle-choice-label">
                                            <strong>@ChronicleChoiceText(choice.Label)</strong>
                                            @if (choice.EchoIndicator)
                                            {
                                                <img class="chronicle-choice-echo-icon" src="images/card-ui/wc_icon_echo.png" alt="Echo consequence" />
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(choice.Detail))
                                        {
                                            <span>@ChronicleChoiceText(choice.Detail)</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </article>
                }
            }

            @if (Session.HasPendingCombat && Session.Combat is { } pendingCombat)
            {
                <article class="decision-block combat-gate-block">
                    <div class="decision-kicker">Combat</div>
                    <h3>@pendingCombat.EnemyName</h3>
                    <p><strong>@pendingCombat.SourceLabel</strong> has brought the Host into battle. Review the Chronicle above, then open the battlefield when you are ready.</p>
                    <div class="decision-options">
                        <button @onclick="Session.OpenPendingCombat">
                            <strong>Begin Combat: @pendingCombat.EnemyName</strong>
                            <span>Open the Battle Board.</span>
                        </button>
                    </div>
                </article>
            }

            @if (Session.HasPendingCombat)
            {
            }
            else if (Session.Phase == GamePhase.Camp)
            {
                @if (Session.CampStep == CampStep.Ready)
                {
                    @* Begin Camp is a retained phase gate in the Chronicle above. *@
                }
                else if (Session.CampStep is CampStep.ResolvingSpecial or CampStep.ResolvingAction)
                {
                }
                else if (Session.CampStep == CampStep.ChoosingAction)
                {
                    @* The complete Camp hand is snapshotted and offered in the Chronicle above. *@
                }
                else if (Session.CampStep == CampStep.Complete)
                {
                    <div class="awaiting-event"><strong>Camp complete.</strong></div>
                }
            }
            else if (Session.Phase == GamePhase.EndOfSeason)
            {
                @if (Session.EndOfSeasonStep is EndOfSeasonStep.Ready
                    or EndOfSeasonStep.VulnerabilityReady
                    or EndOfSeasonStep.HarvestReady)
                {
                    @* These single-use transitions now live permanently in the Chronicle. *@
                }
                else if (Session.EndOfSeasonStep == EndOfSeasonStep.HarvestPreparing)
                {
                    <article class="decision-block eos-block harvest-block">
                        <div class="decision-kicker">Harvest</div>
                        <h3>Prepare the Baggage Train</h3>
                        <p>The Harvest is staged beside the Host. Before packing any of it, you may purge carried Resources or dump carried Firepots to make room. If you have a Market, you may sell up to 2 purged Resources instead.</p>

                        <div class="eos-subsection">
                            <h4>Staged Harvest</h4>
                            <div class="eos-resource-grid">
                                @foreach (var staged in Session.HarvestStaging.Where(x => x.Value > 0))
                                {
                                    <div class="eos-resource-row">
                                        <span><strong>@staged.Value</strong> @staged.Key waiting to be packed</span>
                                    </div>
                                }
                                @if (!Session.HarvestStaging.Any(x => x.Value > 0))
                                {
                                    <span class="empty-state">No resources were staged this Harvest.</span>
                                }
                            </div>
                        </div>

                        <div class="eos-subsection">
                            <h4>Carried Stores</h4>
                            @if (Session.PersistentItems.Any(p => p.Name == "Market"))
                            {
                                <p class="eos-note">Market sales remaining: <strong>@Session.HarvestMarketSalesRemaining</strong></p>
                            }
                            <div class="eos-baggage-list">
                                @foreach (var slot in Session.Baggage)
                                {
                                    <div class="eos-baggage-row">
                                        <span>Slot @slot.Position: <strong>@BaggageLabel(slot)</strong>@(slot.Damaged ? " (Damaged)" : string.Empty)</span>
                                        <div class="eos-inline-actions">
                                            <button disabled="@(!Session.CanPurgeHarvestBaggage(slot.Position))" @onclick="() => Session.PurgeHarvestBaggage(slot.Position)">@(string.Equals(slot.Contents, "Firepots", StringComparison.OrdinalIgnoreCase) ? "Dump Firepots" : "Purge 1")</button>
                                            @if (Session.PersistentItems.Any(p => p.Name == "Market"))
                                            {
                                                <button disabled="@(!Session.CanSellHarvestBaggage(slot.Position))" @onclick="() => Session.SellHarvestBaggage(slot.Position)">Sell 1</button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="harvest-undo-row">
                            <button class="secondary-action" disabled="@(!Session.CanUndoHarvestPreparation)" @onclick="Session.UndoHarvestPreparation">Undo Last</button>
                            <span>Undo purge or sale actions until packing begins.</span>
                        </div>

                        <div class="decision-options eos-finish-row">
                            <button @onclick="Session.BeginEndOfSeasonPacking">
                                <strong>Pack the Harvest</strong>
                                <span>Finish clearing space, then choose which staged Resources to carry forward.</span>
                            </button>
                        </div>
                    </article>
                }
                else if (Session.EndOfSeasonStep == EndOfSeasonStep.HarvestPacking)
                {
                    <article class="decision-block eos-block harvest-block">
                        <div class="decision-kicker">Harvest</div>
                        <h3>Pack the Harvest</h3>
                        <p>Choose which staged Resources to place in the Baggage Train. Anything left behind when you finish is returned to the supply.</p>

                        <div class="eos-subsection">
                            <h4>Staged Harvest</h4>
                            <div class="eos-resource-grid">
                                @foreach (var staged in Session.HarvestStaging.Where(x => x.Value > 0))
                                {
                                    <div class="eos-resource-row">
                                        <span><strong>@staged.Value</strong> @staged.Key</span>
                                        <button disabled="@(!Session.CanPackHarvestResource(staged.Key))" @onclick="() => Session.PackHarvestResource(staged.Key)">Pack 1</button>
                                    </div>
                                }
                                @if (!Session.HarvestStaging.Any(x => x.Value > 0))
                                {
                                    <span class="empty-state">No staged resources remain.</span>
                                }
                            </div>
                        </div>

                        <div class="eos-subsection">
                            <h4>Baggage Train</h4>
                            <div class="eos-baggage-list">
                                @foreach (var slot in Session.Baggage)
                                {
                                    <div class="eos-baggage-row">
                                        <span>Slot @slot.Position: <strong>@BaggageLabel(slot)</strong>@(slot.Damaged ? " (Damaged)" : string.Empty)</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="harvest-undo-row">
                            <button class="secondary-action" disabled="@(!Session.CanUndoHarvestPacking)" @onclick="Session.UndoHarvestPacking">Undo Last</button>
                            <span>Undo packed Resources until Harvest is finished.</span>
                        </div>

                        <div class="decision-options eos-finish-row">
                            <button @onclick="Session.FinishEndOfSeasonHarvest">
                                <strong>Finish Harvest</strong>
                                <span>Unpacked staged Resources are returned to the supply.</span>
                            </button>
                        </div>
                    </article>
                }
                else if (Session.EndOfSeasonStep == EndOfSeasonStep.ConsolidationReady)
                {
                    @* Retained, checked Chronicle decision. *@
                }
                else if (Session.EndOfSeasonStep == EndOfSeasonStep.RefitReform)
                {
                    <article class="decision-block eos-block refit-block">
                        <div class="decision-kicker">End of Summer</div>
                        <h3>Refit &amp; Reform</h3>
                        <p>Recruit units and purchase available Advancements. Make as many purchases as you can afford, then continue.</p>

                        <div class="eos-subsection">
                            <h4>Recruit</h4>
                            <div class="decision-options refit-recruit-grid">
                                @foreach (var type in new[] { "Archers", "Infantry", "Cavalry", "Levy" })
                                {
                                    <button disabled="@(!Session.CanRefitRecruit(type))" @onclick="() => Session.RefitRecruit(type)">
                                        <strong>@Session.RefitRecruitLabel(type)</strong>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="eos-subsection refit-dismiss-block">
                            <h4>Reconfigure Host</h4>
                            <p>Dismiss a unit back to Available Forces with no refund. Dismissing a Military Unit frees a Military slot; dismissing Levy only frees Levy capacity.</p>
                            <div class="decision-options refit-dismiss-grid">
                                @foreach (var type in new[] { "Archers", "Infantry", "Cavalry", "Levy" })
                                {
                                    <button disabled="@(!Session.CanRefitDismiss(type))" @onclick="() => Session.RefitDismiss(type)">
                                        <strong>Dismiss 1 @Session.RefitDismissLabel(type)</strong>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="eos-subsection">
                            <h4>Advancements on Offer</h4>
                            <div class="camp-choice-list refit-offer-list">
                                @foreach (var offer in Session.AdvancementOffer)
                                {
                                    var commitLabel = Catalog.GetAdvancementCommitLabel(offer.Id);
                                    <article class="camp-choice-card @(!Session.CanBuyRefitAdvancement(offer.Id) ? "is-unavailable" : string.Empty)">
                                        <div class="camp-choice-heading">
                                            <strong>@offer.Name</strong>
                                            <span class="advancement-cost-tokens">@ChronicleCostMarkup(offer.Cost)</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(commitLabel))
                                        {
                                            <div class="advancement-commit-cost">Commit: @commitLabel</div>
                                        }
                                        <p class="camp-choice-flavor">@offer.Effect</p>
                                        <button class="camp-choice-select" disabled="@(!Session.CanBuyRefitAdvancement(offer.Id))" @onclick="() => Session.BuyRefitAdvancement(offer.Id)">
                                            Buy @offer.Name
                                        </button>
                                    </article>
                                }
                            </div>
                            <button class="secondary-action" disabled="@(!Session.CanCycleRefitAdvancement)" @onclick="Session.CycleRefitAdvancement">Pay 1 Coin to discard the top Advancement</button>
                        </div>

                        <div class="refit-undo-row">
                            <button class="secondary-action" disabled="@(!Session.CanUndoRefitReform)" @onclick="Session.UndoRefitReform">Undo Last R&amp;R Action</button>
                            <span>Available until you finish this Refit &amp; Reform phase.</span>
                        </div>

                        <div class="decision-options eos-finish-row">
                            <button @onclick="Session.FinishRefitReform">
                                <strong>Finish Refit &amp; Reform</strong>
                            </button>
                        </div>
                    </article>
                }
            }
            else if (Session.Phase == GamePhase.Winter)
            {
                @if (Session.WinterStep == WinterStep.Ready)
                {
                    @* Begin Winter is a retained, checked Chronicle decision. *@
                }
                else if (Session.WinterStep == WinterStep.Attrition)
                {
                    @if (Session.FlowPrompt is null)
                    {
                        <div class="awaiting-event"><strong>Resolving Winter Attrition...</strong></div>
                    }
                }
                else if (Session.WinterStep == WinterStep.RefitReform)
                {
                    <article class="decision-block eos-block refit-block winter-block">
                        <div class="decision-kicker">Winter • Year @Session.Year</div>
                        <h3>Refit &amp; Reform</h3>
                        <p>Rebuild after Attrition. Recruit units and purchase available Advancements, then finish Winter.</p>

                        <div class="eos-subsection">
                            <h4>Recruit</h4>
                            <div class="decision-options refit-recruit-grid">
                                @foreach (var type in new[] { "Archers", "Infantry", "Cavalry", "Levy" })
                                {
                                    <button disabled="@(!Session.CanRefitRecruit(type))" @onclick="() => Session.RefitRecruit(type)">
                                        <strong>@Session.RefitRecruitLabel(type)</strong>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="eos-subsection refit-dismiss-block">
                            <h4>Reconfigure Host</h4>
                            <p>Dismiss a unit back to Available Forces with no refund. Dismissing a Military Unit frees a Military slot; dismissing Levy only frees Levy capacity.</p>
                            <div class="decision-options refit-dismiss-grid">
                                @foreach (var type in new[] { "Archers", "Infantry", "Cavalry", "Levy" })
                                {
                                    <button disabled="@(!Session.CanRefitDismiss(type))" @onclick="() => Session.RefitDismiss(type)">
                                        <strong>Dismiss 1 @Session.RefitDismissLabel(type)</strong>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="eos-subsection">
                            <h4>Advancements on Offer</h4>
                            <div class="camp-choice-list refit-offer-list">
                                @foreach (var offer in Session.AdvancementOffer)
                                {
                                    var commitLabel = Catalog.GetAdvancementCommitLabel(offer.Id);
                                    <article class="camp-choice-card @(!Session.CanBuyRefitAdvancement(offer.Id) ? "is-unavailable" : string.Empty)">
                                        <div class="camp-choice-heading">
                                            <strong>@offer.Name</strong>
                                            <span class="advancement-cost-tokens">@ChronicleCostMarkup(offer.Cost)</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(commitLabel))
                                        {
                                            <div class="advancement-commit-cost">Commit: @commitLabel</div>
                                        }
                                        <p class="camp-choice-flavor">@offer.Effect</p>
                                        <button class="camp-choice-select" disabled="@(!Session.CanBuyRefitAdvancement(offer.Id))" @onclick="() => Session.BuyRefitAdvancement(offer.Id)">
                                            Buy @offer.Name
                                        </button>
                                    </article>
                                }
                            </div>
                            <button class="secondary-action" disabled="@(!Session.CanCycleRefitAdvancement)" @onclick="Session.CycleRefitAdvancement">Pay 1 Coin to discard the top Advancement</button>
                        </div>

                        <div class="refit-undo-row">
                            <button class="secondary-action" disabled="@(!Session.CanUndoRefitReform)" @onclick="Session.UndoRefitReform">Undo Last R&amp;R Action</button>
                            <span>Available until you finish this Refit &amp; Reform phase.</span>
                        </div>

                        <div class="decision-options eos-finish-row">
                            <button @onclick="Session.FinishRefitReform">
                                <strong>Finish Winter Refit &amp; Reform</strong>
                                <span>Check for defeat, reset the Camp deck, stabilize the Market, and begin the next Year.</span>
                            </button>
                        </div>
                    </article>
                }
                else if (Session.WinterStep == WinterStep.Defeat)
                {
                    <article class="decision-block eos-block winter-block">
                        <div class="decision-kicker">Winter • Year @Session.Year</div>
                        <h3>The Host Is Gone</h3>
                        <p>No Units remain after Winter Refit &amp; Reform. The campaign ends here.</p>
                    </article>
                }
            }
            else if (Session.Phase == GamePhase.Finale)
            {
                <article class="decision-block">
                    <div class="decision-kicker">Finale</div>
                    <h3>Middelalderen</h3>
                    <p>The campaign has reached its final test. Resolve the Finale preparation window to begin the assault.</p>
                </article>
            }
            else if (Session.Phase == GamePhase.GameOver)
            {
                <article class="decision-block game-over-block">
                    <div class="decision-kicker">Campaign Complete</div>
                    <h3>@(Session.CampaignOutcome ?? "The Chronicle Ends")</h3>
                    <p>@Session.CampaignEndReason</p>
                    <div class="game-log-complete">
                        <p>The complete game log is saved automatically to the local <code>GameLogs</code> folder and retained in this browser as a backup.</p>
                        @if (!string.IsNullOrWhiteSpace(_gameLogFilename))
                        {
                            <code>@_gameLogFilename</code>
                        }
                        <div class="game-log-actions">
                            <button class="secondary-action" @onclick="DownloadGameLogAsync">Download Game Log</button>
                            @if (string.Equals(Session.CampaignOutcome, "Defeat", StringComparison.OrdinalIgnoreCase))
                            {
                                <button class="secondary-action" @onclick="StartNewGameFromDefeatAsync">New Game</button>
                            }
                        </div>
                    </div>
                </article>
            }
            else if (Session.MobilizationStep == MobilizationStep.ExploreReady)
            {
                @* Explore is a retained phase gate in the Chronicle above. *@
            }
            else if (Session.MobilizationStep == MobilizationStep.TerrainChoice)
            {
                <article class="decision-block">
                    <div class="decision-kicker">Scouting</div>
                    <h3>Choose Terrain</h3>
                    <div class="decision-options">
                        @foreach (var terrain in Session.PendingTerrainChoices)
                        {
                            <button @onclick="() => Session.ChooseTerrain(terrain)"><strong>@terrain</strong></button>
                        }
                    </div>
                </article>
            }
            else if (Session.MobilizationStep == MobilizationStep.ExploreEncounter && Session.PendingExploreCard is not null)
            {
                @* The live encounter is represented by append-only Chronicle entries above. *@
            }
            else if (Session.MobilizationStep == MobilizationStep.ArrivalReady)
            {
                @* Proceed to Arrival is a retained phase gate above. *@
            }
            else if (Session.MobilizationStep == MobilizationStep.ArrivalEncounter)
            {
                @* Arrival reveal, tests, and choices remain in the append-only Chronicle above. *@
            }
            else if (Session.MobilizationStep == MobilizationStep.ArrivalComplete)
            {
                <div class="awaiting-event"><strong>Camp Phase</strong></div>
            }
        </div>
    </section>
</div>

@if (_showCustomFinaleSetup)
{
    <div class="modal-backdrop custom-finale-backdrop">
        <section class="custom-finale-modal" role="dialog" aria-modal="true" aria-label="Configure Custom Finale">
            <header class="custom-finale-header">
                <div>
                    <div class="eyebrow">Debug • Post-Resolve test</div>
                    <h2>Custom Finale</h2>
                    <p>Set up an exact matchup. The campaign is untouched, and this uses the normal Middelalderen combat rules.</p>
                </div>
                <button class="combat-test-cancel" @onclick="() => _showCustomFinaleSetup = false">Cancel</button>
            </header>
            <div class="custom-finale-scroll">
                <div class="custom-finale-grid">
                    <section class="custom-finale-section">
                        <h3>Your Host</h3>
                        <p>Unit counts before combat. Usual maximum is 10 Military and 6 Levy; debug tests also permit unusual matchups.</p>
                        <div class="custom-unit-grid">
                            @foreach (var type in CustomFinaleUnitTypes)
                            {
                                <label><span>@type</span><input type="number" min="0" max="24" value="@_customFinale.PlayerUnits[type]" @onchange="e => SetCustomUnits(_customFinale.PlayerUnits, type, e.Value)" /></label>
                            }
                        </div>
                        <p><strong>Special units</strong> (fight in their regular combat classes)</p>
                        <div class="custom-unit-grid">
                            @foreach (var type in new[] { "Mercenaries", "Hedge Knights" })
                            {
                                <label><span>@type</span><input type="number" min="0" max="24" value="@_customFinale.SpecialPlayerUnits[type]" @onchange="e => SetCustomUnits(_customFinale.SpecialPlayerUnits, type, e.Value)" /></label>
                            }
                        </div>
                        <small>@(_customFinale.PlayerUnits["Archers"] + _customFinale.PlayerUnits["Cavalry"] + _customFinale.PlayerUnits["Infantry"] + _customFinale.SpecialPlayerUnits["Mercenaries"] + _customFinale.SpecialPlayerUnits["Hedge Knights"]) Military (including specialists) / @_customFinale.PlayerUnits["Levy"] Levy</small>
                        <div class="custom-finale-fields">
                            <label>Morale <input type="number" min="0" max="10" @bind="_customFinale.Morale" /></label>
                            <label>Leadership (after Resolve) <input type="number" min="0" max="99" @bind="_customFinale.Leadership" /></label>
                            <label class="custom-check"><input type="checkbox" @bind="_customFinale.HasPriest" /> Priest present</label>
                        </div>
                    </section>
                    <section class="custom-finale-section">
                        <h3>Middelalderen</h3>
                        <p>Choose the starting Host. Selected Advancements normally add at most one Archer, Cavalry, Infantry, or Levy unit of each type (Gritty adds a Levy).</p>
                        <div class="custom-unit-grid">
                            @foreach (var type in CustomFinaleUnitTypes)
                            {
                                <label><span>@type base</span><input type="number" min="0" max="24" value="@_customFinale.MiddelalderenBaseUnits[type]" @onchange="e => SetCustomUnits(_customFinale.MiddelalderenBaseUnits, type, e.Value)" /></label>
                            }
                        </div>
                        <p class="custom-final-total">With Advancement bonuses: @CustomEnemyHostSummary()</p>
                        <label class="custom-check"><input type="checkbox" @bind="_customFinale.OverrideMiddelalderenUnits" /> Override final enemy unit counts (including bonuses)</label>
                        @if (_customFinale.OverrideMiddelalderenUnits)
                        {
                            <div class="custom-unit-grid">
                                @foreach (var type in CustomFinaleUnitTypes)
                                {
                                    <label><span>@type final</span><input type="number" min="0" max="24" value="@_customFinale.MiddelalderenOverrideUnits[type]" @onchange="e => SetCustomUnits(_customFinale.MiddelalderenOverrideUnits, type, e.Value)" /></label>
                                }
                            </div>
                            <small>Overrides ignore automatic unit bonuses; the chosen totals are deployed verbatim.</small>
                        }
                    </section>
                    <section class="custom-finale-section">
                        <h3>Your Advancements</h3>
                        <p>Select individual cards, including separate Armor copies.</p>
                        <div class="custom-advancement-list">
                            @foreach (var card in Catalog.GetBaseAdvancements())
                            {
                                <label title="@card.Effect"><input type="checkbox" checked="@_customFinale.PlayerAdvancements.Contains(card.Id)" @onchange="_ => ToggleCustomPlayerAdvancement(card.Id)" /><span>@card.Name <small>(@card.Id)</small></span></label>
                            }
                        </div>
                    </section>
                    <section class="custom-finale-section">
                        <h3>Middelalderen Advancements</h3>
                        <p>Select exactly which enemy cards appear, including each Armor copy. <strong>@_customFinale.MiddelalderenAdvancements.Count selected.</strong></p>
                        <div class="custom-advancement-list">
                            @foreach (var card in Catalog.GetMiddelalderenAdvancements())
                            {
                                <label title="@card.Effect"><input type="checkbox" checked="@_customFinale.MiddelalderenAdvancements.Contains(card.Id)" @onchange="_ => ToggleCustomSelection(_customFinale.MiddelalderenAdvancements, card.Id)" /><span>@card.Name <small>(@card.Id)</small></span></label>
                            }
                        </div>
                    </section>
                    <section class="custom-finale-section custom-span-all">
                        <h3>Pre-committed Tactics</h3>
                        <p>These Tactics are committed before combat at the normal cost of 1 Leadership apiece. Inspired and Loose Formation activate in battle. Feigned Withdrawal cannot be committed in a no-disengagement Finale.</p>
                        <div class="custom-tactics-list">
                            @foreach (var card in Catalog.GetBaseAdvancements().Where(c => CustomAdvancementNumber(c.Id) is >= 7 and <= 13 && c.Id != "ADV-011"))
                            {
                                <label title="@card.Effect"><input type="checkbox" disabled="@(!_customFinale.PlayerAdvancements.Contains(card.Id) || (CustomTacticIssue(card.Id) is not null && !_customFinale.CommittedTactics.Contains(card.Id)))" checked="@_customFinale.CommittedTactics.Contains(card.Id)" @onchange="_ => ToggleCustomSelection(_customFinale.CommittedTactics, card.Id)" /><span>@card.Name</span></label>
                            }
                        </div>
                        @if (_customFinale.CommittedTactics.Contains("ADV-013"))
                        {
                            <label class="custom-steady">Steady Advance target
                                <select @bind="_customFinale.SteadyAdvanceType">
                                    <option value="">Choose unit type…</option>
                                    @foreach (var type in CustomFinaleUnitTypes.Where(t => t != "Levy"))
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </label>
                        }
                        <p class="custom-final-total">Leadership entering combat: @(_customFinale.Leadership - _customFinale.CommittedTactics.Count)</p>
                    </section>
                    <section class="custom-finale-section custom-span-all">
                        <h3>Replay &amp; Dice</h3>
                        <p>Same seed replays the same random sequence. During/after combat, use <strong>New Dice</strong> to repeat this matchup with another seed.</p>
                        <label class="custom-seed">Random seed <input type="number" min="0" max="2147483647" @bind="_customFinale.Seed" /></label>
                    </section>
                </div>
            </div>
            <footer class="custom-finale-footer">
                @if (CustomFinaleProblem is { } problem)
                {
                    <span class="custom-finale-error" role="alert">@problem</span>
                }
                else
                {
                    <span>Resolve check skipped. Battle uses your chosen post-Resolve Leadership.</span>
                }
                <button class="combat-primary" disabled="@(CustomFinaleProblem is not null)" @onclick="LaunchCustomFinale">Stage Custom Finale</button>
            </footer>
        </section>
    </div>
}

@if (Session.Finale is { } finale && Session.Combat is null && (finale.Step != FinaleStep.Complete || !_finaleSummaryDismissed))
{
    <div class="modal-backdrop finale-backdrop">
        <section class="finale-modal" role="dialog" aria-modal="true" aria-label="Finale">
            <header>
                <div>
                    <div class="eyebrow">@(finale.IsCustomTest ? "Custom Finale" : finale.IsTest ? "Test Finale" : "Finale")</div>
                    <h2>Middelalderen</h2>
                    <div class="combat-phase-label">@FinaleStepLabel(finale.Step)</div>
                </div>
                <div class="combat-header-tools">
                    <a class="combat-window-button combat-window-link" href="War_Chronicle_Rulebook.pdf" target="_blank" rel="noopener">Rulebook</a>
                    @if (finale.IsTest)
                    {
                        <div class="combat-test-tools">
                            @if (finale.TestSeed is int finaleSeed)
                            {
                                <span>Seed @finaleSeed</span>
                                <button class="combat-test-cancel" @onclick="Session.RestartTestFinale">Restart Seed</button>
                            }
                            @if (finale.IsCustomTest)
                            {
                                <button class="combat-test-cancel" @onclick="Session.RerollTestFinale">New Dice</button>
                            }
                            @if (finale.IsCustomTest)
                            {
                                <button class="combat-test-cancel" @onclick="DownloadCustomFinaleLogAsync">Download Test Log</button>
                            }
                            <button class="combat-test-cancel" @onclick="Session.CancelTestFinale">Cancel Test Finale</button>
                        </div>
                    }
                </div>
            </header>

            <div class="finale-workspace">
                <aside class="finale-host-summary">
                    <h3>Your Host</h3>
                    <div class="finale-stat-row"><span>Morale</span><strong>@finale.Morale</strong></div>
                    <div class="finale-stat-row"><span>Leadership</span><strong>@finale.Leadership</strong></div>
                    <div class="finale-stat-row"><span>Priest</span><strong>@(finale.HasPriest ? "Yes" : "No")</strong></div>
                    @foreach (var type in new[] { "Archers", "Cavalry", "Infantry", "Levy" })
                    {
                        <div class="finale-stat-row"><span>@type</span><strong>@(finale.PlayerUnits[type])</strong></div>
                    }

                    @if (finale.PlayerAdvancements.Count > 0)
                    {
                        <h4>Advancements</h4>
                        <div class="finale-chip-list">
                            @foreach (var id in finale.PlayerAdvancements.OrderBy(id => id))
                            {
                                <span class="combat-status-chip" title="@Session.CombatTacticEffect(id)">@Session.CombatTacticName(id)</span>
                            }
                        </div>
                    }
                </aside>

                <main class="finale-control-pane">
                    @if (finale.Step == FinaleStep.ResolveReady)
                    {
                        <section class="finale-step-card">
                            <div class="decision-kicker">Host Resolve Check</div>
                            <h3>Steel the Host for the final assault</h3>
                            <p>Roll 1d10 against Morale. Before making a Morale d10 roll, you may spend 1 Leadership to roll 2d10 and choose 1 result.</p>
                            <div class="finale-button-row">
                                <button class="combat-primary" @onclick="() => Session.ResolveFinaleCheck(false)">Roll 1d10</button>
                                <button class="combat-primary" disabled="@(!Session.CanSpendLeadershipForFinaleResolve)" @onclick="() => Session.ResolveFinaleCheck(true)">Spend 1 Leadership • Roll 2d10</button>
                            </div>
                        </section>
                    }
                    else if (finale.Step == FinaleStep.ResolveChoose)
                    {
                        <section class="finale-step-card">
                            <div class="decision-kicker">Host Resolve Check</div>
                            <h3>Choose the Resolve result</h3>
                            <div class="finale-roll-choice">
                                @for (var i = 0; i < finale.ResolveRolls.Count; i++)
                                {
                                    var rollIndex = i;
                                    <button @onclick="() => Session.ChooseFinaleResolveRoll(rollIndex)">@finale.ResolveRolls[i]</button>
                                }
                            </div>
                        </section>
                    }
                    else if (finale.Step == FinaleStep.DeployHost)
                    {
                        <section class="finale-step-card">
                            <div class="decision-kicker">Deploy Your Host</div>
                            <h3>Commit Tactics before Middelalderen reveals its Advancements</h3>
                            <p>Committed Tactics cost 1 Leadership. Inspired and Loose Formation remain available for their normal in-combat triggers.</p>
                            <div class="combat-tactic-grid">
                                @foreach (var tacticId in finale.PlayerAdvancements.Where(id => TacticNumber(id) is >= 7 and <= 15).OrderBy(id => id))
                                {
                                    var number = TacticNumber(tacticId);
                                    var isSpecial = number is 14 or 15;
                                    var committed = finale.CommittedTactics.Contains(tacticId);
                                    <button class="combat-tactic @(committed ? "is-committed" : string.Empty) @(isSpecial ? "is-special" : string.Empty)"
                                            disabled="@(isSpecial || !Session.CanToggleFinaleTactic(tacticId))"
                                            @onclick="() => Session.ToggleFinaleTactic(tacticId)">
                                        <strong>@Session.CombatTacticName(tacticId)</strong>
                                        <span>@Session.CombatTacticEffect(tacticId)</span>
                                        <small>@(isSpecial ? "Available when its trigger occurs" : committed ? "Committed" : (Session.FinaleTacticUnavailableReason(tacticId) is { } reason ? $"Unavailable: {reason}" : "Commit: 1 Leadership"))</small>
                                    </button>
                                }
                            </div>

                            @if (finale.CommittedTactics.Contains("ADV-013"))
                            {
                                <div class="finale-steady-advance">
                                    <strong>Steady Advance:</strong> choose the Military unit type now, before Middelalderen is revealed.
                                    <div class="finale-button-row compact">
                                        @foreach (var type in new[] { "Archers", "Cavalry", "Infantry" }.Where(t => finale.PlayerUnits[t] > 0))
                                        {
                                            <button class="@(finale.SteadyAdvanceType == type ? "is-selected" : string.Empty)" @onclick="() => Session.SetFinaleSteadyAdvanceType(type)">@type</button>
                                        }
                                    </div>
                                </div>
                            }

                            <button class="combat-primary" disabled="@(!Session.CanRevealMiddelalderen)" @onclick="Session.RevealMiddelalderen">Lock Deployment &amp; Reveal Middelalderen</button>
                        </section>
                    }
                    else if (finale.Step == FinaleStep.RevealMiddelalderen)
                    {
                        <section class="finale-step-card">
                            <div class="decision-kicker">Deploy Middelalderen's Host</div>
                            <h3>Middelalderen reveals @finale.MiddelalderenAdvancements.Count Advancements</h3>
                            <div class="finale-enemy-grid">
                                @foreach (var id in finale.MiddelalderenAdvancements.OrderBy(id => id))
                                {
                                    <article>
                                        <strong>@Session.CombatTacticName(id)</strong>
                                        <span>@Session.CombatTacticEffect(id)</span>
                                    </article>
                                }
                            </div>
                            <div class="finale-enemy-force">
                                @foreach (var type in new[] { "Archers", "Cavalry", "Infantry", "Levy" })
                                {
                                    <span>@type <strong>@(finale.MiddelalderenUnits[type])</strong></span>
                                }
                            </div>
                            <button class="combat-primary" @onclick="Session.StartFinaleCombat">Begin Final Combat</button>
                        </section>
                    }
                    else if (finale.Step == FinaleStep.Complete)
                    {
                        <section class="finale-step-card finale-result-card">
                            <div class="decision-kicker">Finale Complete</div>
                            <h3>@(finale.Outcome == "Won" ? "Middelalderen Falls" : "The Host Is Destroyed")</h3>
                            <p>@(finale.Outcome == "Won" ? "The Host survives the final battle and takes Middelalderen." : "The campaign ends before the walls of Middelalderen.")</p>
                            <div class="finale-button-row">
                                <button class="combat-primary" @onclick="CloseFinaleSummary">Close &amp; Read Chronicle</button>
                                @if (finale.IsTest)
                                {
                                    <button class="combat-primary" @onclick="Session.RestartTestFinale">Restart Seed</button>
                                    @if (finale.IsCustomTest)
                                    {
                                        <button class="combat-primary" @onclick="Session.RerollTestFinale">New Dice</button>
                                    }
                                    @if (finale.IsCustomTest)
                                    {
                                        <button class="combat-primary" @onclick="DownloadCustomFinaleLogAsync">Download Test Log</button>
                                    }
                                    <button class="combat-primary" @onclick="Session.EndTestFinale">End Test Finale</button>
                                }
                            </div>
                        </section>
                    }

                    <section class="finale-log-panel">
                        <h3>Finale Chronicle</h3>
                        @foreach (var line in finale.Log)
                        {
                            <p>@line</p>
                        }
                    </section>
                </main>
            </div>
        </section>
    </div>
}

@if (Session.CombatVisible && Session.Combat is { } combat)
{
    <div class="modal-backdrop combat-backdrop @(IsCombatMinimized(combat) ? "is-minimized" : string.Empty)">
        @if (IsCombatMinimized(combat))
        {
            <section class="combat-minimized-bar" role="status" aria-label="Combat minimized for inspection">
                <div class="combat-minimized-summary">
                    <span class="eyebrow">Combat • Inspection only</span>
                    <strong>@combat.EnemyName</strong>
                    <span>Round @combat.Round • @Session.CombatStepLabel</span>
                </div>
                <div class="combat-header-tools">
                    <a class="combat-window-button combat-window-link" href="War_Chronicle_Rulebook.pdf" target="_blank" rel="noopener">Rulebook</a>
                    <button class="combat-window-button" @onclick="MaximizeCombat" title="Restore the Combat window">Maximize</button>
                </div>
            </section>
        }
        else
        {
        <section class="combat-modal battleboard-modal" role="dialog" aria-modal="true" aria-label="Combat">
            <header>
                <div>
                    <div class="eyebrow">@combat.SourceLabel</div>
                    <h2>@combat.EnemyName</h2>
                    <div class="combat-phase-label">Round @combat.Round • @Session.CombatStepLabel</div>
                </div>
                <div class="combat-header-tools">
                    <a class="combat-window-button combat-window-link" href="War_Chronicle_Rulebook.pdf" target="_blank" rel="noopener">Rulebook</a>
                    @if (combat.IsTest)
                    {
                        <div class="combat-test-tools">
                            @if (combat.TestSeed is int seed)
                            {
                                <span>Seed @seed</span>
                                <button class="combat-test-cancel" @onclick="Session.RestartTestCombat">Restart Seed</button>
                                @if (combat.IsFinale && Session.Finale?.IsCustomTest == true)
                                {
                                    <button class="combat-test-cancel" @onclick="Session.RerollTestFinale">New Dice</button>
                                }
                            }
                            @if (combat.IsFinale && Session.Finale?.IsCustomTest == true)
                            {
                                <button class="combat-test-cancel" @onclick="DownloadCustomFinaleLogAsync">Download Test Log</button>
                            }
                            <button class="combat-test-cancel" @onclick="Session.CancelTestCombat">@(combat.IsFinale ? "Cancel Test Finale" : "Cancel Test Combat")</button>
                        </div>
                    }
                    <button class="combat-window-button" @onclick="() => MinimizeCombat(combat)" title="Temporarily collapse Combat so you can inspect the campaign state">Minimize</button>
                </div>
            </header>

            <div class="combat-workspace">
                <div class="combat-battle-pane">
                    <div class="battle-board-shell">
                        <img src="images/WC-BattleBoard.png" alt="War Chronicle Battle Board" class="battle-board-image" />
                        <div class="battle-enemy-name">@combat.EnemyName</div>

                        @if (combat.ChoiceTargetSide is "enemy" or "player")
                        {
                            <div class="battle-casualty-highlight @combat.ChoiceTargetSide" aria-hidden="true">
                                <span>@(combat.ChoiceTargetSide == "enemy" ? "CHOOSE ENEMY CASUALTY" : "CHOOSE YOUR CASUALTY")</span>
                            </div>
                        }

                        @foreach (var side in new[] { "enemy", "player" })
                        {
                            foreach (var type in new[] { "Archers", "Cavalry", "Infantry", "Levy" })
                            {
                                var battlePieces = BattlePieces(side, type, combat).ToList();
                                <div class="battle-unit-stack @side @BattleLaneClass(type)">
                                    @for (var pieceIndex = 0; pieceIndex < battlePieces.Count; pieceIndex++)
                                    {
                                        var piece = battlePieces[pieceIndex];
                                        var stackStyle = BattlePieceStackStyle(pieceIndex, battlePieces.Count);
                                        @if (piece.ImagePath is not null)
                                        {
                                            <img class="battle-unit-image @piece.CssClass" style="@stackStyle" src="@piece.ImagePath" title="@piece.Title" alt="" />
                                        }
                                        else
                                        {
                                            <span class="battle-unit @piece.CssClass" style="@stackStyle" title="@piece.Title"></span>
                                        }
                                    }
                                </div>
                            }
                        }

                        @if (combat.EnemyPriest)
                        {
                            <span class="battle-priest enemy" title="Enemy Priest"></span>
                        }
                        @if (combat.PlayerPriest)
                        {
                            <span class="battle-priest player" title="Player Priest"></span>
                        }

                        <div class="battle-leadership-readout">
                            <strong>L @combat.PlayerLeadership</strong>
                            @if (combat.PlayerShields > 0)
                            {
                                <span class="combat-shield-count" title="@($"Shields: {combat.PlayerShields}")" aria-label="@($"Shields: {combat.PlayerShields}")">
                                    @for (var shieldIndex = 0; shieldIndex < combat.PlayerShields; shieldIndex++)
                                    {
                                        <img src="images/tokens/shield.png" alt="" />
                                    }
                                </span>
                            }
                        </div>
                    </div>

                    @{
                        var combatTokenReminders = Session.VisibleReminders
                            .Where(IsCombatTokenReminder)
                            .ToArray();
                    }
                    @if (combatTokenReminders.Length > 0)
                    {
                        <div class="combat-token-strip" aria-label="Active expansion tokens">
                            <span class="combat-status-label">Active Tokens</span>
                            @foreach (var tokenName in combatTokenReminders)
                            {
                                var combatTokenPath = PersistentTokenPath(tokenName);
                                <span class="combat-token-reminder" title="@PersistentTooltip(tokenName)">
                                    @if (combatTokenPath is not null)
                                    {
                                        <img src="@combatTokenPath" alt="" />
                                    }
                                    <span>@tokenName</span>
                                </span>
                            }
                        </div>
                    }

                    @if (combat.PlayerDevelopments.Count > 0 || combat.PlayerTactics.Count > 0)
                    {
                        <div class="combat-status-strip">
                            @if (combat.PlayerDevelopments.Count > 0)
                            {
                                <span class="combat-status-label">Developments</span>
                                @foreach (var developmentId in combat.PlayerDevelopments.OrderBy(id => id))
                                {
                                    <span class="combat-status-chip" title="@Session.CombatTacticEffect(developmentId)">@Session.CombatTacticName(developmentId)</span>
                                }
                            }
                            @if (combat.CommittedTactics.Count > 0)
                            {
                                <span class="combat-status-label">Committed Tactics</span>
                                @foreach (var tacticId in combat.CommittedTactics.OrderBy(id => id))
                                {
                                    <span class="combat-status-chip tactic" title="@Session.CombatTacticEffect(tacticId)">@Session.CombatTacticName(tacticId)</span>
                                }
                            }
                            @foreach (var tacticId in combat.PlayerTactics.Where(id => TacticNumber(id) is 14 or 15).OrderBy(id => id))
                            {
                                <span class="combat-status-chip special" title="@Session.CombatTacticEffect(tacticId)">@Session.CombatTacticName(tacticId)</span>
                            }
                        </div>
                    }

                    @if (combat.EnemyAdvancements.Count > 0)
                    {
                        <div class="combat-status-strip enemy-status-strip">
                            <span class="combat-status-label">Middelalderen</span>
                            @foreach (var advancementId in combat.EnemyAdvancements.OrderBy(id => id))
                            {
                                <span class="combat-status-chip enemy" title="@Session.CombatTacticEffect(advancementId)">@Session.CombatTacticName(advancementId)</span>
                            }
                            @if (combat.EnemyShields > 0)
                            {
                                <span class="combat-status-chip enemy combat-enemy-shields" title="@($"Shields: {combat.EnemyShields}")">
                                    @for (var shieldIndex = 0; shieldIndex < combat.EnemyShields; shieldIndex++)
                                    {
                                        <img src="images/tokens/shield.png" alt="" />
                                    }
                                </span>
                            }
                        </div>
                    }

                    <div class="combat-initiative" aria-label="Combat initiative">
                        @foreach (var lane in new[] { "Priest", "Archers", "Cavalry", "Infantry", "Levy" })
                        {
                            <span class="@CombatInitiativeClass(lane, combat)">@lane</span>
                        }
                    </div>
                </div>

                <div class="combat-control-pane">
                    @if (combat.Step == CombatStep.Setup && combat.PlayerTactics.Count > 0)
                    {
                        <div class="combat-tactics-panel">
                            <h3>Tactics</h3>
                            <p>@(combat.LockPlayerTactics ? "Finale Tactics were locked before Middelalderen revealed its Advancements." : "Commit any available Tactics before the first round. Most committed Tactics cost 1 Leadership.")</p>
                            <div class="combat-tactic-grid">
                                @foreach (var tacticId in combat.PlayerTactics.OrderBy(id => id))
                                {
                                    var number = TacticNumber(tacticId);
                                    var isSpecial = number is 14 or 15;
                                    var committed = combat.CommittedTactics.Contains(tacticId);
                                    <button class="combat-tactic @(committed ? "is-committed" : string.Empty) @(isSpecial ? "is-special" : string.Empty)"
                                            disabled="@(isSpecial || !Session.CanToggleCombatTactic(tacticId))"
                                            @onclick="() => Session.ToggleCombatTactic(tacticId)">
                                        <strong>@Session.CombatTacticName(tacticId)</strong>
                                        <span>@Session.CombatTacticEffect(tacticId)</span>
                                        <small>@(isSpecial ? "Available when its trigger occurs" : committed ? "Committed" : (Session.CombatTacticUnavailableReason(tacticId) is { } reason ? $"Unavailable: {reason}" : "Commit: 1 Leadership"))</small>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (combat.Step != CombatStep.Setup && combat.CommittedTactics.Count > 0)
                    {
                        <div class="combat-tactics-panel active-tactics-panel">
                            <h3>Committed Tactics</h3>
                            <p>These Tactics remain in effect for this Combat.</p>
                            <div class="combat-tactic-grid">
                                @foreach (var tacticId in combat.CommittedTactics.OrderBy(id => id))
                                {
                                    <div class="combat-tactic is-committed persistent-tactic-card">
                                        <strong>@Session.CombatTacticName(tacticId)</strong>
                                        <span>@Session.CombatTacticEffect(tacticId)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="combat-action-panel">
                        <div class="decision-kicker">@Session.CombatStepLabel</div>
                        @if (!string.IsNullOrWhiteSpace(combat.CurrentUnitType) && (combat.PlayerRoll.Count > 0 || combat.EnemyRoll.Count > 0))
                        {
                            <div class="combat-roll-summary">
                                <div class="combat-roll-row">
                                    <span>Host</span>
                                    <div class="combat-dice">
                                        @foreach (var die in combat.PlayerRoll)
                                        {
                                            <i class="combat-die @(die.Hit ? "is-hit" : string.Empty) @(die.Rout ? "is-rout" : string.Empty) @(die.Rerolled ? "is-rerolled" : string.Empty)" title="@(die.Rout ? "Rout result" : die.Hit ? "Hit" : null)">@die.Value</i>
                                        }
                                        @if (combat.PlayerRoll.Count == 0)
                                        {
                                            <em>no dice</em>
                                        }
                                    </div>
                                </div>
                                <div class="combat-roll-row">
                                    <span>Enemy</span>
                                    <div class="combat-dice">
                                        @foreach (var die in combat.EnemyRoll)
                                        {
                                            <i class="combat-die @(die.Hit ? "is-hit" : string.Empty) @(die.Rout ? "is-rout" : string.Empty)" title="@(die.Rout ? "Rout result" : die.Hit ? "Hit" : null)">@die.Value</i>
                                        }
                                        @if (combat.EnemyRoll.Count == 0)
                                        {
                                            <em>no dice</em>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @if (combat.ChoiceTargetSide is "enemy" or "player")
                        {
                            <div class="combat-casualty-target-banner @combat.ChoiceTargetSide">
                                <strong>@(combat.ChoiceTargetSide == "enemy" ? "ENEMY HOST" : "YOUR HOST")</strong>
                                <span>Choose the casualty from this force.</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(combat.ChoicePrompt))
                        {
                            <p>@combat.ChoicePrompt</p>
                        }

                        @if (combat.Choices.Count > 0)
                        {
                            <div class="decision-options combat-choice-options">
                                @foreach (var choice in combat.Choices)
                                {
                                    <button @onclick="() => Session.ResolveCombatChoice(choice.Id)">
                                        <strong>@choice.Label</strong>
                                        @if (!string.IsNullOrWhiteSpace(choice.Detail))
                                        {
                                            <span>@choice.Detail</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                        else if (combat.AwaitingClose)
                        {
                            <button class="combat-primary" @onclick="Session.CloseCombat">@(combat.IsFinale ? "Resolve Finale" : combat.IsTest ? "End Test Combat" : combat.Outcome == "Lost" ? "End Campaign" : "Return to the Chronicle")</button>
                        }
                        else
                        {
                            <button class="combat-primary" @onclick="Session.AdvanceCombat">@Session.CombatAdvanceLabel</button>
                        }
                    </div>

                    <div class="combat-log-panel">
                        <h3>Battle Chronicle</h3>
                        <div class="combat-log">
                            @foreach (var item in combat.Log)
                            {
                                <p class="@(item.Subdued ? "subdued" : string.Empty)">@item.Text</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
        }
    </div>
}

