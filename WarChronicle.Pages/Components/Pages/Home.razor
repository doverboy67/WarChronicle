    private readonly Dictionary<string, string?> _arrivalTribeMetaCache = new(StringComparer.OrdinalIgnoreCase);

    // Keep Echo provenance in the saved Calendar value for backwards
    // compatibility, but present it immediately BELOW the title in the UI.
    private static string ChronicleCalendarStamp(string calendar)
    {
        var index = calendar.IndexOf(" • Seeded by: ", StringComparison.OrdinalIgnoreCase);
        return index < 0 ? calendar : calendar[..index];
    }

    private static string? ChronicleEchoOrigin(string calendar)
    {
        if (!calendar.Contains("• Echo", StringComparison.OrdinalIgnoreCase))
            return null;
        const string marker = " • Seeded by: ";
        var index = calendar.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        return index < 0 ? null : calendar[(index + marker.Length)..];
    }

    private static bool IsWinterDisbandReminder(ChronicleEntry entry)
        => entry.Heading == "Hedge Knights"
            && (entry.Calendar.Contains("• Explore", StringComparison.OrdinalIgnoreCase)
                || entry.Choices is not null)
           || entry.Heading == "Hire Mercenaries" && entry.Choices is not null;

    private static string WinterDisbandReminder(ChronicleEntry entry)
        => entry.Heading == "Hedge Knights"
            ? "Reminder: Hedge Knights disband in Winter."
            : "Reminder: Mercenaries disband in Winter.";

    private string? ArrivalTribeMeta(ChronicleEntry entry)
    {
        if (string.IsNullOrWhiteSpace(entry.Heading) ||
            !entry.Calendar.Contains("• Arrival", StringComparison.OrdinalIgnoreCase))
            return null;

        if (_arrivalTribeMetaCache.TryGetValue(entry.Heading, out var cached))
            return cached;

        var arrival = Catalog.GetArrivalCards().FirstOrDefault(card =>
            string.Equals(card.Title, entry.Heading, StringComparison.OrdinalIgnoreCase));
        _arrivalTribeMetaCache[entry.Heading] = arrival?.Tribe;
        return arrival?.Tribe;
    }

