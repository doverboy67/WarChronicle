    private static string BattlePieceStackStyle(int index, int count)
    {
        // Fan pieces diagonally like a physical stack. The total spread is capped so even
        // large unit groups remain inside their printed battle-board lane while every
        // token still exposes enough of itself to be counted.
        if (count <= 1)
        {
            return "left:50%;top:50%;z-index:1;";
        }

        var midpoint = (count - 1) / 2.0;
        var horizontalStep = Math.Min(13.0, 62.0 / (count - 1));
        var verticalStep = Math.Min(8.0, 32.0 / (count - 1));
        var left = 50.0 + ((index - midpoint) * horizontalStep);
        var top = 50.0 + ((index - midpoint) * verticalStep);

        return FormattableString.Invariant($"left:{left:0.###}%;top:{top:0.###}%;z-index:{index + 1};");
    }

