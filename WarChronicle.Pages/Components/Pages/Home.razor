    private static void SetCustomUnits(Dictionary<string, int> units, string type, object? value)
    {
        if (int.TryParse(value?.ToString(), out var number))
            units[type] = Math.Clamp(number, 0, 24);
    }

    private int CustomEnemyCount(string type)
    {
        var count = _customFinale.MiddelalderenBaseUnits[type];
        var bonus = type switch
        {
            "Archers" => new[] { "ADV-M6", "ADV-M9" },
            "Cavalry" => new[] { "ADV-M5", "ADV-M7" },
            "Infantry" => new[] { "ADV-M4", "ADV-M10" },
            "Levy" => new[] { "ADV-M8" },
            _ => Array.Empty<string>()
        };
        return count + (bonus.Any(_customFinale.MiddelalderenAdvancements.Contains) ? 1 : 0);
    }

    private string CustomEnemyHostSummary()
        => string.Join(" / ", CustomFinaleUnitTypes.Select(t => $"{CustomEnemyCount(t)} {t}"));

    private int CustomCombatUnitCount(string type) => _customFinale.PlayerUnits.GetValueOrDefault(type) +
        (type == "Infantry" ? _customFinale.SpecialPlayerUnits.GetValueOrDefault("Mercenaries") :
         type == "Cavalry" ? _customFinale.SpecialPlayerUnits.GetValueOrDefault("Hedge Knights") : 0);

    private string? CustomTacticIssue(string id)
    {
        var required = id switch
        {
            "ADV-007" => "Cavalry",
            "ADV-008" => "Levy",
            "ADV-009" or "ADV-012" => "Archers",
            "ADV-010" => "Infantry",
            _ => null
        };
        if (required is not null && CustomCombatUnitCount(required) <= 0)
            return $"{required} required to commit {Catalog.GetAdvancement(id)?.Name ?? id}.";
        if (id == "ADV-013" && CustomFinaleUnitTypes.Take(3).All(t => CustomCombatUnitCount(t) == 0))
            return "Steady Advance requires a Military unit.";
        return null;
    }

    private string? CustomFinaleProblem
    {
        get
        {
            if (_customFinale.Morale is < 0 or > 10) return "Morale must be between 0 and 10.";
            if (_customFinale.Leadership is < 0 or > 99) return "Leadership must be between 0 and 99.";
            if (_customFinale.Seed < 0) return "Seed cannot be negative.";
            if (_customFinale.PlayerUnits.Values.Sum() + _customFinale.SpecialPlayerUnits.Values.Sum() == 0) return "Your Host needs at least one unit.";
            if (_customFinale.MiddelalderenAdvancements.Count is < 1 or > 10) return "Select 1 to 10 Middelalderen Advancements.";
            if (_customFinale.CommittedTactics.Count > _customFinale.Leadership) return "Not enough Leadership to commit those Tactics.";
            foreach (var id in _customFinale.CommittedTactics)
                if (CustomTacticIssue(id) is { } reason) return reason;
            if (_customFinale.CommittedTactics.Contains("ADV-013") &&
                (string.IsNullOrWhiteSpace(_customFinale.SteadyAdvanceType) ||
                 CustomCombatUnitCount(_customFinale.SteadyAdvanceType) == 0))
                return "Steady Advance needs an existing Archer, Cavalry, or Infantry unit type.";
            var enemyCount = _customFinale.OverrideMiddelalderenUnits
                ? _customFinale.MiddelalderenOverrideUnits.Values.Sum()
                : CustomFinaleUnitTypes.Sum(CustomEnemyCount);
            if (enemyCount == 0) return "Middelalderen needs at least one unit.";
            return null;
        }
    }

    private void LaunchCustomFinale()
