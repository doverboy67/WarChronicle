    }

    private async Task ArchiveCompletedGameLogAsync()
    {
        if (Session.GameEndedUtc is null || _archivedGameLogId == Session.GameLogId)
            return;

        var json = Session.CreateGameLogJson(AppVersion);
        var fileSaved = false;

        try
        {
            // The real playtest archive is a JSON file on disk.
            _gameLogFilename = await GameLogFiles.SaveCompletedGameAsync(json, Session.GameEndedUtc.Value);
            fileSaved = true;
        }
        catch
        {
            // Filesystem logging is best-effort and must never interrupt play.
        }

        try
        {
            // Browser storage remains a redundant backup and supports manual download.
            var browserFilename = await JS.InvokeAsync<string>("wcGameLog.archive", json);
            if (string.IsNullOrWhiteSpace(_gameLogFilename))
                _gameLogFilename = browserFilename;
        }
        catch
        {
            // Browser backup is also best-effort.
        }

        // Once either automatic archive path succeeds, do not create duplicate files
        // on later renders. If both fail, leave this unset so a later render retries.
        if (fileSaved || !string.IsNullOrWhiteSpace(_gameLogFilename))
            _archivedGameLogId = Session.GameLogId;

        await InvokeAsync(StateHasChanged);
    }

