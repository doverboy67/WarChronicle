    private async Task DownloadGameLogAsync()
    {
        try
        {
            var json = Session.CreateGameLogJson(AppVersion);
            // Never gate an explicit download on browser storage or archive quota.
            // Automatic archiving remains best-effort in ArchiveCompletedGameLogAsync.
            var filename = !string.IsNullOrWhiteSpace(_gameLogFilename)
                ? _gameLogFilename
                : $"WC_GameLog_{(Session.GameEndedUtc ?? DateTime.UtcNow).ToLocalTime():yyyy-MM-dd_HH-mm-ss}.json";
