    private readonly Dictionary<string, string> _echoIconCache = new(StringComparer.OrdinalIgnoreCase);

    private string? ChronicleIconPath(ChronicleEntry entry)
    {
        if (entry.Calendar.Contains("• Scene", StringComparison.OrdinalIgnoreCase))
            return "images/card-ui/wc_icon_scene.png";
        if (!entry.Calendar.Contains("• Echo", StringComparison.OrdinalIgnoreCase))
            return null;

        var title = entry.Heading ?? string.Empty;
        if (_echoIconCache.TryGetValue(title, out var cached))
            return cached;

        var echo = Catalog.GetCampCards(includeOptional: true)
            .FirstOrDefault(c => string.Equals(c.CardType, "Echo", StringComparison.OrdinalIgnoreCase)
                && string.Equals(c.Title, entry.Heading, StringComparison.OrdinalIgnoreCase));
        var icon = echo is not null && string.Equals(echo.Keyword, "Hostile", StringComparison.OrdinalIgnoreCase)
            ? "images/card-ui/wc_icon_hostile.png"
            : "images/card-ui/wc_icon_echo.png";
        _echoIconCache[title] = icon;
        return icon;
    }

    private bool IsDepleted(int index)
    {
        if (index < 0 || index >= Session.PlayArea.Count)
            return false;

        var element = Session.PlayArea[index];
        if (element.Kind != PlayAreaKind.Terrain)
            return false;

        bool hostileBefore = index > 0
            && Session.PlayArea[index - 1].Kind == PlayAreaKind.Clearing
            && Session.PlayArea[index - 1].IsHostile;

        bool hostileAfter = index < Session.PlayArea.Count - 1
            && Session.PlayArea[index + 1].Kind == PlayAreaKind.Clearing
            && Session.PlayArea[index + 1].IsHostile;

        return element.IsDepleted || hostileBefore || hostileAfter;
    }

